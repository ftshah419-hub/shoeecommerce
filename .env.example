# ====================================================================
# NELEERI SNEAKERS - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / MySQL / MongoDB URI)
DB_URI=postgresql://user:password@localhost:5432/neleeri_sneakers

# Authentication & Security Secrets
JWT_SECRET=neleeri_super_secure_jwt_secret_key_2026_buildathon
JWT_EXPIRES_IN=7d
COOKIE_SECRET=neleeri_super_secure_cookie_secret_2026

# Seeded Administrator Account
ADMIN_EMAIL=admin@neleerisneakers.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_NAME="Sneakers SuperAdmin"

# SMTP Email Delivery Provider (Optional - Console Simulator used when empty)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=your_smtp_password
SMTP_FROM="NELEERI Sneakers <no-reply@neleerisneakers.com>"

# SMS Gateway Provider (Optional - Console Simulator used when empty)
SMS_API_KEY=your_sms_gateway_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+15551234567

# Social Authentication OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
APPLE_CLIENT_ID=com.neleerisneakers.web.client
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
