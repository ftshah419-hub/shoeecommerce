<%- include('../partials/admin-header') %>
<%- include('../partials/navbar') %>

<main class="container section">
  <div class="admin-header-bar">
    <div class="admin-title-wrap">
      <span class="badge-admin">Admin Control Panel</span>
      <h1>Sneaker Inventory Management</h1>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <div class="admin-grid">
    <%- include('../partials/admin-sidebar', { activePage: 'products' }) %>

    <div>
      <!-- Add Sneaker Form with Live Image Preview -->
      <div style="background: var(--bg-card); padding: 1.75rem; border-radius: var(--radius); border: 1px solid var(--border); margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1.25rem;">+ Add New Sneaker to Catalog</h3>
        <form action="/admin/products" method="POST">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
            <div class="form-group">
              <label class="form-label">Sneaker Model Name *</label>
              <input type="text" name="name" class="form-control" placeholder="e.g. Neleeri Velocity Pro" required>
            </div>
            <div class="form-group">
              <label class="form-label">Brand / Line *</label>
              <input type="text" name="brand" class="form-control" placeholder="e.g. Neleeri Lab" required>
            </div>
            <div class="form-group">
              <label class="form-label">Category</label>
              <select name="category" class="form-control">
                <option value="Running">Running</option>
                <option value="Basketball">Basketball</option>
                <option value="Streetwear">Streetwear</option>
                <option value="Casual">Casual</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Price ($ USD) *</label>
              <input type="number" step="0.01" name="price" class="form-control" placeholder="159.99" required>
            </div>
            <div class="form-group">
              <label class="form-label">Stock Units</label>
              <input type="number" name="stock" class="form-control" placeholder="25" value="20" required>
            </div>
            <div class="form-group">
              <label class="form-label">Sizes (comma-separated)</label>
              <input type="text" name="sizes" class="form-control" placeholder="8, 9, 10, 11, 12" value="8, 9, 10, 11, 12">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Image URL</label>
            <input 
              type="url" 
              id="adminSneakerImageUrl" 
              name="image" 
              class="form-control" 
              placeholder="https://images.unsplash.com/..." 
              value="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80"
            >
            <div id="adminSneakerImagePreview"></div>
          </div>

          <div class="form-group">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="2" placeholder="Engineered with breathable mesh and responsive cushioning..."></textarea>
          </div>

          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
            <input type="checkbox" id="featured" name="featured" value="true">
            <label for="featured" style="font-size: 0.9rem; color: var(--text-muted); cursor: pointer;">Feature on Homepage</label>
          </div>

          <button type="submit" class="btn btn-primary">Create Sneaker</button>
        </form>
      </div>

      <!-- Inventory Table with Live Table Search -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="font-size: 1.25rem;">Current Sneaker Inventory (<%= products.length %>)</h3>
        <input 
          type="text" 
          id="adminTableSearch" 
          class="form-control" 
          style="width: 250px; padding: 0.45rem 0.85rem; font-size: 0.85rem;" 
          placeholder="Filter sneakers by name, brand..."
        >
      </div>

      <div class="admin-table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Preview</th>
              <th>Name</th>
              <th>Brand / Cat</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Featured</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(product => { %>
              <tr>
                <td>
                  <img src="<%= product.image %>" alt="<%= product.name %>" style="width: 50px; height: 40px; object-fit: cover; border-radius: 4px;">
                </td>
                <td><strong><%= product.name %></strong></td>
                <td><%= product.brand %> (<%= product.category %>)</td>
                <td>$<%= product.price.toFixed(2) %></td>
                <td>
                  <span style="font-weight: 700; color: <%= product.stock < 10 ? 'var(--danger)' : 'var(--success)' %>">
                    <%= product.stock %> units
                  </span>
                </td>
                <td><%= product.featured ? '⭐ Yes' : 'No' %></td>
                <td>
                  <form class="confirm-delete-form" action="/admin/products/<%= product.id %>/delete" method="POST">
                    <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/admin-footer') %>
