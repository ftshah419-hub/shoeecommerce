<%- include('../partials/admin-header', { title: 'Customers & Sneaker Squad - Neleeri Sneakers' }) %>
<%- include('../partials/admin-sidebar', { activePage: 'customers', activeSection: 'Customers' }) %>
<%- include('../partials/admin-topbar', { activePage: 'customers', activeSection: 'Customers' }) %>

<main id="adminMainContent" class="transition-all duration-300 lg:pl-64 pt-16 min-h-screen bg-slate-50">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold font-heading text-slate-900 tracking-tight">Registered Customers &amp; Squad</h1>
        <p class="text-sm text-slate-500 mt-1">Inspect registered sneaker buyers, order histories, delivery addresses, and account statuses.</p>
      </div>

      <!-- Search Bar -->
      <form method="GET" action="/admin/customers" class="flex items-center gap-2">
        <div class="relative w-72">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">search</span>
          <input 
            name="search"
            value="<%= searchQuery || '' %>"
            class="w-full pl-9 pr-4 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-blue-600 focus:ring-1 focus:ring-blue-600 text-slate-800 shadow-xs"
            placeholder="Search name, email, phone..."
            type="text"
          />
        </div>
        <button type="submit" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl transition-colors shadow-xs">
          Search
        </button>
      </form>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Total Registered</span>
        <div class="text-xl font-bold text-slate-900 font-heading mt-1"><%= customers.length %></div>
      </div>
      <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Active Squad</span>
        <div class="text-xl font-bold text-emerald-600 font-heading mt-1">
          <%= customers.filter(c => c.status !== 'inactive' && c.status !== 'suspended').length %>
        </div>
      </div>
      <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Verified Buyers</span>
        <div class="text-xl font-bold text-blue-600 font-heading mt-1">
          <%= customers.filter(c => c.order_count > 0).length %>
        </div>
      </div>
      <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">High LTV VIPs</span>
        <div class="text-xl font-bold text-indigo-600 font-heading mt-1">
          <%= customers.filter(c => c.total_spent > 15000).length %>
        </div>
      </div>
    </div>

    <!-- Customers Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-slate-500 uppercase tracking-wider text-[11px] border-b border-slate-100 bg-slate-50/70">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Customer Profile</th>
              <th class="py-3.5 px-4 font-semibold">Contact Email</th>
              <th class="py-3.5 px-4 font-semibold">Phone Number</th>
              <th class="py-3.5 px-4 font-semibold">Orders Placed</th>
              <th class="py-3.5 px-4 font-semibold">Total Spent (LTV)</th>
              <th class="py-3.5 px-4 font-semibold">Account Status</th>
              <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (customers && customers.length > 0) { %>
              <% customers.forEach((c) => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <!-- Profile -->
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-xl bg-slate-900 text-white font-bold flex items-center justify-center text-xs">
                        <%= c.name ? c.name.charAt(0).toUpperCase() : 'C' %>
                      </div>
                      <div>
                        <div class="font-bold text-slate-900"><%= c.name || 'Sneaker Fan' %></div>
                        <div class="text-[11px] text-slate-400 font-mono">UID: <%= c.id %></div>
                      </div>
                    </div>
                  </td>

                  <!-- Email -->
                  <td class="py-3.5 px-4 text-slate-600 font-mono text-[11px]">
                    <%= c.email %>
                  </td>

                  <!-- Phone -->
                  <td class="py-3.5 px-4 text-slate-600 font-mono text-[11px]">
                    <%= c.phone || '+91 98201 44910' %>
                  </td>

                  <!-- Orders -->
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-800">
                    <%= c.order_count || 0 %> orders
                  </td>

                  <!-- Spent LTV -->
                  <td class="py-3.5 px-4 font-mono font-bold text-slate-900">
                    ₹<%= (c.total_spent || 0).toLocaleString('en-IN') %>
                  </td>

                  <!-- Status -->
                  <td class="py-3.5 px-4">
                    <% const isActive = c.status !== 'inactive' && c.status !== 'suspended'; %>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= isActive ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-600 border border-red-200' %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= isActive ? 'bg-emerald-500' : 'bg-red-500' %>"></span>
                      <span><%= isActive ? 'ACTIVE' : 'SUSPENDED' %></span>
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="py-3.5 px-4 text-right">
                    <div class="inline-flex items-center gap-2">
                      <button 
                        type="button" 
                        onclick="inspectCustomer('<%= c.id %>')"
                        class="p-1.5 text-slate-500 hover:text-blue-600 rounded-lg hover:bg-slate-100" 
                        title="View Customer Profile"
                      >
                        <span class="material-symbols-outlined text-[17px]">visibility</span>
                      </button>
                      <form method="POST" action="/admin/customers/<%= c.id %>/status" class="inline">
                        <input type="hidden" name="status" value="<%= isActive ? 'suspended' : 'active' %>" />
                        <button 
                          type="submit" 
                          class="px-2 py-1 text-[11px] font-semibold rounded-lg <%= isActive ? 'text-red-500 hover:bg-red-50' : 'text-emerald-600 hover:bg-emerald-50' %> transition-colors"
                          title="Toggle Account Status"
                        >
                          <%= isActive ? 'Suspend' : 'Activate' %>
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="py-12 text-center text-slate-400">
                  <span class="material-symbols-outlined text-[32px] text-slate-300 block mb-2">people</span>
                  <p class="font-medium text-sm text-slate-600">No registered customers match your search.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>

<!-- Customer Detail Modal -->
<div id="customerDetailModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-elevated border border-slate-200">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900 font-heading">Customer Profile &amp; Order History</h3>
        <p class="text-xs text-slate-500">Registered member coordinates and past purchases.</p>
      </div>
      <button onclick="closeModal('customerDetailModal')" class="text-slate-400 hover:text-slate-600 p-1">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <div id="customerModalContent" class="space-y-4 mt-4">
      <!-- Populated via fetch -->
      <div class="p-8 text-center text-slate-400 text-xs">Loading profile...</div>
    </div>
  </div>
</div>

<script>
  async function inspectCustomer(customerId) {
    openModal('customerDetailModal');
    const container = document.getElementById('customerModalContent');
    container.innerHTML = '<div class="p-8 text-center text-slate-400 text-xs">Fetching customer telemetry from database...</div>';

    try {
      const res = await fetch('/admin/customers/' + customerId + '/detail');
      const data = await res.json();
      const user = data.user;
      const orders = data.orders || [];
      const addresses = data.addresses || [];

      container.innerHTML = `
        <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200/80">
          <div class="w-10 h-10 rounded-xl bg-slate-900 text-white font-bold flex items-center justify-center text-sm">
            ${user.name ? user.name.charAt(0).toUpperCase() : 'C'}
          </div>
          <div>
            <h4 class="text-sm font-bold text-slate-900">${user.name || 'Sneaker Squad Member'}</h4>
            <p class="text-xs text-slate-500 font-mono">${user.email}</p>
          </div>
        </div>

        <div class="space-y-1 text-xs">
          <div class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">Saved Addresses</div>
          ${addresses.length > 0 ? addresses.map(a => `
            <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100 text-slate-600">
              ${a.address_line1 || ''}, ${a.city || ''}, ${a.state || ''} - ${a.postal_code || ''}
            </div>
          `).join('') : '<p class="text-slate-400 text-xs">No address saved yet.</p>'}
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs font-bold text-slate-700 uppercase tracking-wider text-[11px]">
            <span>Recent Orders (${orders.length})</span>
            <span class="text-blue-600 font-mono">LTV: ₹${(data.totalSpent || 0).toLocaleString('en-IN')}</span>
          </div>
          <div class="max-h-48 overflow-y-auto space-y-2 divide-y divide-slate-100">
            ${orders.length > 0 ? orders.map(o => `
              <div class="flex items-center justify-between pt-2 text-xs">
                <div>
                  <span class="font-mono font-bold text-slate-800">${o.order_number || o.id}</span>
                  <div class="text-[10px] text-slate-400">${new Date(o.created_at || Date.now()).toLocaleDateString()}</div>
                </div>
                <div class="text-right">
                  <span class="font-mono font-bold text-slate-900">₹${(o.final_amount || o.totalAmount || 0).toLocaleString('en-IN')}</span>
                  <div class="text-[10px] font-semibold text-blue-600 uppercase">${o.order_status || o.status}</div>
                </div>
              </div>
            `).join('') : '<p class="text-slate-400 text-xs py-2">No orders placed yet.</p>'}
          </div>
        </div>
      `;
    } catch (e) {
      container.innerHTML = `<div class="p-4 text-center text-red-500 text-xs">Error loading customer details: ${e.message}</div>`;
    }
  }
</script>

<%- include('../partials/admin-footer') %>
