<%- include('../partials/admin-header', { title: 'Product Categories - Neleeri Sneakers' }) %>
<%- include('../partials/admin-sidebar', { activePage: 'categories', activeSection: 'Catalog' }) %>
<%- include('../partials/admin-topbar', { activePage: 'categories', activeSection: 'Catalog' }) %>

<main id="adminMainContent" class="transition-all duration-300 lg:pl-64 pt-16 min-h-screen bg-slate-50">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold font-heading text-slate-900 tracking-tight">Footwear Categories &amp; Taxonomy</h1>
        <p class="text-sm text-slate-500 mt-1">Structure sneaker drops, sport disciplines, lifestyle segments, and exclusive collaborations.</p>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/admin/products" 
          class="inline-flex items-center gap-2 px-3.5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl border border-slate-200 shadow-xs transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">inventory_2</span>
          <span>View Products</span>
        </a>
        <button 
          type="button" 
          onclick="openModal('addCategoryModal')" 
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[18px]">add_circle</span>
          <span>Add Category</span>
        </button>
      </div>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% (categories || []).forEach(cat => { %>
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card overflow-hidden hover:shadow-subtle transition-shadow flex flex-col justify-between">
          <div>
            <div class="h-44 w-full bg-slate-100 overflow-hidden relative">
              <img src="<%= cat.image_url || 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=600&q=80' %>" alt="<%= cat.name %>" class="w-full h-full object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-white">
                <span class="font-bold text-base font-heading"><%= cat.name %></span>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-white/20 backdrop-blur-md">
                  /<%= cat.slug %>
                </span>
              </div>
            </div>

            <div class="p-5 space-y-3">
              <p class="text-xs text-slate-600 leading-relaxed">
                <%= cat.description || 'Curated high-performance category for urban sneakers.' %>
              </p>
            </div>
          </div>

          <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-mono text-[11px]">
              Status: <strong class="text-emerald-600">Active</strong>
            </span>

            <div class="flex items-center gap-2">
              <button 
                type="button" 
                onclick="editCategory(<%= JSON.stringify(cat) %>)" 
                class="px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/60 rounded-lg text-xs font-semibold transition-colors"
              >
                Edit
              </button>
              <form method="POST" action="/admin/categories/<%= cat.id %>/delete" onsubmit="return confirm('Remove category <%= cat.name %>?');" class="inline">
                <button type="submit" class="px-2 py-1 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg text-xs transition-colors">
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</main>

<!-- Modal: Add Category -->
<div id="addCategoryModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-elevated border border-slate-200">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900 font-heading">Add Category</h3>
        <p class="text-xs text-slate-500">Define a new footwear taxonomy segment.</p>
      </div>
      <button onclick="closeModal('addCategoryModal')" class="text-slate-400 hover:text-slate-600 p-1">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form method="POST" action="/admin/categories" class="space-y-4 mt-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Category Name *</label>
        <input type="text" name="name" required placeholder="e.g. Retro Basketball" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Slug URL Identifier</label>
        <input type="text" name="slug" placeholder="retro-basketball" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Header Image URL</label>
        <input type="url" name="image_url" placeholder="https://images.unsplash.com/..." class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Description</label>
        <textarea name="description" rows="2" placeholder="Iconic high-top sneakers designed for court style..." class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeModal('addCategoryModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-sm transition-all">
          Create Category
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Edit Category -->
<div id="editCategoryModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-elevated border border-slate-200">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900 font-heading">Edit Category</h3>
        <p class="text-xs text-slate-500">Update taxonomy details.</p>
      </div>
      <button onclick="closeModal('editCategoryModal')" class="text-slate-400 hover:text-slate-600 p-1">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form id="editCategoryForm" method="POST" action="" class="space-y-4 mt-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Category Name *</label>
        <input id="cat_edit_name" type="text" name="name" required class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Slug Identifier</label>
        <input id="cat_edit_slug" type="text" name="slug" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Image URL</label>
        <input id="cat_edit_image" type="url" name="image_url" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Description</label>
        <textarea id="cat_edit_desc" name="description" rows="2" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeModal('editCategoryModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-sm transition-all">
          Update Category
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function editCategory(cat) {
    document.getElementById('editCategoryForm').action = '/admin/categories/' + cat.id + '/edit';
    document.getElementById('cat_edit_name').value = cat.name || '';
    document.getElementById('cat_edit_slug').value = cat.slug || '';
    document.getElementById('cat_edit_image').value = cat.image_url || '';
    document.getElementById('cat_edit_desc').value = cat.description || '';
    openModal('editCategoryModal');
  }
</script>

<%- include('../partials/admin-footer') %>
