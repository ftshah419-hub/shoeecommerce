<%- include('../partials/admin-header', { title: 'Admin Users & Personnel - Neleeri Sneakers' }) %>
<%- include('../partials/admin-sidebar', { activePage: 'admin-users', activeSection: 'Administration' }) %>
<%- include('../partials/admin-topbar', { activePage: 'admin-users', activeSection: 'Administration' }) %>

<main id="adminMainContent" class="transition-all duration-300 lg:pl-64 pt-16 min-h-screen bg-slate-50">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold font-heading text-slate-900 tracking-tight">Admin Personnel &amp; Operator Directory</h1>
        <p class="text-sm text-slate-500 mt-1">Manage administrative credentials, security clearance tiers, and operator account access.</p>
      </div>

      <button 
        type="button" 
        onclick="openModal('createAdminModal')" 
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-all"
      >
        <span class="material-symbols-outlined text-[18px]">person_add</span>
        <span>Add Administrator</span>
      </button>
    </div>

    <!-- Admin Personnel Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-slate-500 uppercase tracking-wider text-[11px] border-b border-slate-100 bg-slate-50/70">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Operator Name</th>
              <th class="py-3.5 px-4 font-semibold">Clearance Role</th>
              <th class="py-3.5 px-4 font-semibold">Email / Account ID</th>
              <th class="py-3.5 px-4 font-semibold">Contact Phone</th>
              <th class="py-3.5 px-4 font-semibold">Account Status</th>
              <th class="py-3.5 px-4 font-semibold">Created Date</th>
              <th class="py-3.5 px-4 font-semibold text-right">Role Assignment</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% (adminUsers || []).forEach(adm => { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-xl bg-slate-900 text-white font-bold flex items-center justify-center text-xs">
                      <%= adm.name ? adm.name.charAt(0).toUpperCase() : 'A' %>
                    </div>
                    <div>
                      <div class="font-bold text-slate-900"><%= adm.name %></div>
                      <div class="text-[10px] text-slate-400 font-mono">UID: <%= adm.id %></div>
                    </div>
                  </div>
                </td>

                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-bold uppercase bg-blue-50 text-blue-700 border border-blue-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                    <span><%= adm.role_name || adm.role %></span>
                  </span>
                </td>

                <td class="py-3.5 px-4 font-mono text-slate-600 text-[11px]">
                  <%= adm.email %>
                </td>

                <td class="py-3.5 px-4 font-mono text-slate-600 text-[11px]">
                  <%= adm.phone || '+91 98201 44910' %>
                </td>

                <td class="py-3.5 px-4">
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= adm.status !== 'inactive' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-600 border border-red-200' %>">
                    <span class="w-1.5 h-1.5 rounded-full <%= adm.status !== 'inactive' ? 'bg-emerald-500' : 'bg-red-500' %>"></span>
                    <span><%= adm.status !== 'inactive' ? 'ACTIVE' : 'INACTIVE' %></span>
                  </span>
                </td>

                <td class="py-3.5 px-4 font-mono text-slate-500">
                  <%= adm.created_at ? new Date(adm.created_at).toLocaleDateString() : 'Active' %>
                </td>

                <td class="py-3.5 px-4 text-right">
                  <form method="POST" action="/admin/admin-users/<%= adm.id %>/role" class="inline-flex items-center gap-2">
                    <select name="roleId" class="px-2 py-1 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-800 focus:outline-none">
                      <% (roles || []).forEach(r => { %>
                        <option value="<%= r.id %>" <%= (adm.role === r.name || adm.roleId === r.id) ? 'selected' : '' %>>
                          <%= r.name %>
                        </option>
                      <% }) %>
                    </select>
                    <button type="submit" class="px-2.5 py-1 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold transition-colors">
                      Update
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>

<!-- Modal: Create Administrator -->
<div id="createAdminModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-elevated border border-slate-200">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900 font-heading">Register New Administrator</h3>
        <p class="text-xs text-slate-500">Create operator account and assign security clearance role.</p>
      </div>
      <button onclick="closeModal('createAdminModal')" class="text-slate-400 hover:text-slate-600 p-1">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form method="POST" action="/admin/admin-users" class="space-y-4 mt-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Full Operator Name *</label>
        <input type="text" name="name" required placeholder="e.g. Maya Lin" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Email Identifier *</label>
        <input type="email" name="email" required placeholder="operator@neleerisneakers.com" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Password *</label>
          <input type="password" name="password" required placeholder="••••••••" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Clearance Tier *</label>
          <select name="roleId" required class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800">
            <% (roles || []).forEach(r => { %>
              <option value="<%= r.id %>"><%= r.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Contact Phone</label>
        <input type="tel" name="phone" placeholder="+91 98201 44910" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeModal('createAdminModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-sm transition-all">
          Authorize Operator
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/admin-footer') %>
