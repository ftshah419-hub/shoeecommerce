<%- include('../partials/admin-header', { title: 'Roles & Permissions Matrix - Neleeri Sneakers' }) %>
<%- include('../partials/admin-sidebar', { activePage: 'roles', activeSection: 'Administration' }) %>
<%- include('../partials/admin-topbar', { activePage: 'roles', activeSection: 'Administration' }) %>

<main id="adminMainContent" class="transition-all duration-300 lg:pl-64 pt-16 min-h-screen bg-slate-50">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold font-heading text-slate-900 tracking-tight">Security Clearance Roles &amp; Permissions</h1>
        <p class="text-sm text-slate-500 mt-1">Fine-grained role-based access control protecting orders, payments, warehouse inventory, and system audits.</p>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/admin/permissions" 
          class="inline-flex items-center gap-2 px-3.5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl border border-slate-200 shadow-xs transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">list</span>
          <span>View Permissions</span>
        </a>
        <button 
          type="button" 
          onclick="openModal('createRoleModal')" 
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[18px]">add_moderator</span>
          <span>Create Role</span>
        </button>
      </div>
    </div>

    <!-- Roles Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <% (roles || []).forEach(role => { %>
        <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card p-6 flex flex-col justify-between gap-5 hover:shadow-subtle transition-shadow">
          <div>
            <div class="flex items-start justify-between">
              <div>
                <div class="flex items-center gap-2">
                  <span class="material-symbols-outlined text-blue-600 text-[22px]">shield</span>
                  <h3 class="font-bold text-base font-heading text-slate-900"><%= role.display_name || role.name %></h3>
                </div>
                <div class="font-mono text-slate-400 text-xs mt-0.5"><%= role.role_name || role.name %></div>
                <p class="text-xs text-slate-600 mt-2"><%= role.description || 'System operator role with custom capabilities.' %></p>
              </div>
              <span class="px-2.5 py-1 bg-blue-50 text-blue-700 font-mono text-[10px] uppercase font-bold border border-blue-200 rounded-full">
                <%= (role.permissions || []).length %> Permissions
              </span>
            </div>

            <!-- Permission Checkbox Form for this role -->
            <form method="POST" action="/admin/roles/<%= role.id %>/permissions" class="mt-4 pt-4 border-t border-slate-100 space-y-3">
              <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Assigned Capabilities:</span>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 max-h-40 overflow-y-auto p-1">
                <% (allPermissions || []).forEach(perm => { %>
                  <% const isChecked = (role.permissions || []).includes(perm.id) || (role.permissions || []).includes(perm.name); %>
                  <label class="flex items-center gap-1.5 p-1.5 rounded-lg hover:bg-slate-50 cursor-pointer text-[11px] text-slate-700">
                    <input 
                      type="checkbox" 
                      name="permissionIds" 
                      value="<%= perm.id %>" 
                      <%= isChecked ? 'checked' : '' %>
                      class="rounded text-blue-600 focus:ring-blue-500"
                    />
                    <span class="truncate" title="<%= perm.description %>"><%= perm.name %></span>
                  </label>
                <% }) %>
              </div>
              <div class="pt-2 flex justify-end">
                <button type="submit" class="px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-semibold transition-colors">
                  Save Permissions
                </button>
              </div>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</main>

<!-- Modal: Create Role -->
<div id="createRoleModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-elevated border border-slate-200">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900 font-heading">Create System Role</h3>
        <p class="text-xs text-slate-500">Define a new RBAC clearance tier.</p>
      </div>
      <button onclick="closeModal('createRoleModal')" class="text-slate-400 hover:text-slate-600 p-1">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form method="POST" action="/admin/roles" class="space-y-4 mt-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Role Display Name *</label>
        <input type="text" name="display_name" required placeholder="e.g. Warehouse Dispatch Specialist" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Role Machine Name *</label>
        <input type="text" name="role_name" required placeholder="dispatch_specialist" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800 font-mono" />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Description</label>
        <textarea name="description" rows="2" placeholder="Authorized to manage airway bills, packages, and logistics routing..." class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeModal('createRoleModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-sm transition-all">
          Register Role
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/admin-footer') %>
