<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Barcode+128&family=Space+Grotesk:wght@600;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f3f4f6; color: #111; }
    .barcode { font-family: 'Libre Barcode 128', cursive; font-size: 48px; }
    @media print {
      body { background: #fff; padding: 0; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="p-8 flex flex-col items-center">
  <div class="no-print mb-6 flex gap-3">
    <button onclick="window.print()" class="bg-black hover:bg-gray-800 text-white font-bold py-2 px-6 rounded shadow">
      Print Shipping Waybill
    </button>
    <button onclick="window.close()" class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-2 px-6 rounded">
      Close Window
    </button>
  </div>

  <!-- Thermal Label Box 4x6 inch style -->
  <div class="bg-white border-4 border-black w-[420px] p-4 text-xs flex flex-col justify-between shadow-xl">
    <!-- Top Carrier Bar -->
    <div class="border-b-4 border-black pb-3 flex justify-between items-center">
      <div>
        <h2 class="text-xl font-black tracking-tight font-['Space_Grotesk']">BLUEDART APEX AIR</h2>
        <span class="bg-black text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-widest">
          PRIORITY AIR CARGO
        </span>
      </div>
      <div class="text-right">
        <span class="text-2xl font-black font-['Space_Grotesk']">BOM / DEL</span>
        <span class="block text-[10px] text-gray-600 font-bold">ROUTE BD-402</span>
      </div>
    </div>

    <!-- Barcode Header -->
    <div class="my-3 text-center border-b-2 border-black pb-2">
      <div class="barcode leading-none"><%= trackingNumber %></div>
      <div class="font-mono text-sm font-bold tracking-widest"><%= trackingNumber %></div>
    </div>

    <!-- Shipper / Receiver Grid -->
    <div class="grid grid-cols-2 gap-3 border-b-2 border-black pb-3">
      <div>
        <p class="font-bold uppercase text-[10px] text-gray-500">FROM / SHIPPER:</p>
        <p class="font-bold text-xs">NELEERI SNEAKERS FULFILLMENT</p>
        <p class="text-[11px] text-gray-700">Hub Kurla, BOM-01</p>
        <p class="text-[11px] text-gray-700">Mumbai, MH 400070</p>
      </div>
      <div>
        <p class="font-bold uppercase text-[10px] text-gray-500">SHIP TO / CONSIGNEE:</p>
        <p class="font-bold text-xs"><%= order.customer_name %></p>
        <p class="text-[11px] text-gray-700 leading-tight"><%= order.shipping_address %></p>
        <p class="text-[11px] font-bold text-gray-900 mt-1">Ph: <%= order.customer_phone || '+91 98201 44810' %></p>
      </div>
    </div>

    <!-- Package Metadata -->
    <div class="grid grid-cols-3 gap-2 py-3 border-b-2 border-black text-center font-bold">
      <div class="border-r border-gray-300">
        <span class="text-[9px] text-gray-500 block uppercase">ORDER REF</span>
        <span class="text-xs">#<%= order.order_number %></span>
      </div>
      <div class="border-r border-gray-300">
        <span class="text-[9px] text-gray-500 block uppercase">WEIGHT</span>
        <span class="text-xs">1.25 KG</span>
      </div>
      <div>
        <span class="text-[9px] text-gray-500 block uppercase">PIN CODE</span>
        <span class="text-sm text-black font-black"><%= order.destination_pincode || '400050' %></span>
      </div>
    </div>

    <!-- Physical Item Manifest -->
    <div class="py-2 border-b-2 border-black text-[11px]">
      <p class="font-bold uppercase text-[9px] text-gray-500">MANIFEST CONTENT:</p>
      <p class="font-bold text-xs">
        <%= (order.items && order.items[0]) ? order.items[0].product_name : 'N01 Sneaker Silhouette' %>
      </p>
      <div class="flex justify-between items-center text-[10px] text-gray-600 mt-0.5">
        <span>SIZE: <%= (order.items && order.items[0]) ? order.items[0].size : 'UK 9.5' %></span>
        <span class="font-mono font-bold text-black">NFC TAG SEAL: VERIFIED</span>
      </div>
    </div>

    <!-- Bottom Footnote -->
    <div class="pt-2 flex justify-between items-center text-[9px] text-gray-500">
      <span>NON-TRANSFERABLE PHYSICAL ASSET</span>
      <span class="font-mono">DISPATCH: <%= new Date().toLocaleTimeString() %></span>
    </div>
  </div>
</body>
</html>
