<%- include('../partials/admin-header', { title: 'Payment Ledger & Settlements - Neleeri Sneakers' }) %>
<%- include('../partials/admin-sidebar', { activePage: 'payments', activeSection: 'Sales' }) %>
<%- include('../partials/admin-topbar', { activePage: 'payments', activeSection: 'Sales' }) %>

<main id="adminMainContent" class="transition-all duration-300 lg:pl-64 pt-16 min-h-screen bg-slate-50">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold font-heading text-slate-900 tracking-tight">Payment Ledger &amp; Settlement Audit</h1>
        <p class="text-sm text-slate-500 mt-1">Gateway reconciliation, UPI instant settlements, transaction tracking, and payment verification.</p>
      </div>

      <!-- Filters & Search Form -->
      <form method="GET" action="/admin/payments" class="flex flex-wrap items-center gap-2">
        <select 
          name="status" 
          onchange="this.form.submit()" 
          class="px-3 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-blue-600 text-slate-700 shadow-xs cursor-pointer"
        >
          <option value="ALL" <%= currentStatus === 'ALL' ? 'selected' : '' %>>All Statuses</option>
          <option value="SUCCESS" <%= currentStatus === 'SUCCESS' ? 'selected' : '' %>>SUCCESS (Settled)</option>
          <option value="PENDING" <%= currentStatus === 'PENDING' ? 'selected' : '' %>>PENDING (Auth Hold)</option>
          <option value="FAILED" <%= currentStatus === 'FAILED' ? 'selected' : '' %>>FAILED</option>
          <option value="REFUNDED" <%= currentStatus === 'REFUNDED' ? 'selected' : '' %>>REFUNDED</option>
        </select>

        <div class="relative w-64">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">search</span>
          <input 
            name="search"
            value="<%= searchQuery || '' %>"
            class="w-full pl-9 pr-4 py-2 text-xs bg-white border border-slate-200 rounded-xl focus:outline-none focus:border-blue-600 text-slate-800 shadow-xs"
            placeholder="Search TXN ID, order, customer..."
            type="text"
          />
        </div>
        <button type="submit" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold rounded-xl transition-colors shadow-xs">
          Filter
        </button>
      </form>
    </div>

    <!-- Payment Stats Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Gross Volume</span>
        <div class="text-2xl font-bold text-slate-900 font-heading mt-2">
          ₹<%= totalVolume.toLocaleString('en-IN') %>
        </div>
        <span class="text-[11px] text-emerald-600 font-semibold mt-1 block">100% Reconciliation Passed</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Settled Transactions</span>
        <div class="text-2xl font-bold text-emerald-600 font-heading mt-2">
          <%= typeof successCount !== 'undefined' ? successCount : (typeof successfulCount !== 'undefined' ? successfulCount : 0) %> <span class="text-xs font-normal text-slate-400">Captured</span>
        </div>
        <span class="text-[11px] text-slate-500 mt-1 block">Instant Gateway Capture</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Authorization Holds</span>
        <div class="text-2xl font-bold text-amber-600 font-heading mt-2">
          <%= pendingCount %> <span class="text-xs font-normal text-slate-400">Pending</span>
        </div>
        <span class="text-[11px] text-amber-500 mt-1 block">Review within 24h</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Gateway SLA</span>
        <div class="text-2xl font-bold text-blue-600 font-heading mt-2">
          99.98%
        </div>
        <span class="text-[11px] text-slate-500 mt-1 block">Razorpay / UPI / Stripe</span>
      </div>
    </div>

    <!-- Payments Ledger Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-slate-500 uppercase tracking-wider text-[11px] border-b border-slate-100 bg-slate-50/70">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Transaction Reference</th>
              <th class="py-3.5 px-4 font-semibold">Order ID</th>
              <th class="py-3.5 px-4 font-semibold">Customer</th>
              <th class="py-3.5 px-4 font-semibold">Payment Method</th>
              <th class="py-3.5 px-4 font-semibold">Amount Captured</th>
              <th class="py-3.5 px-4 font-semibold">Settlement Status</th>
              <th class="py-3.5 px-4 font-semibold text-right">Update Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (payments && payments.length > 0) { %>
              <% payments.forEach((p) => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-4">
                    <span class="font-mono font-bold text-slate-900 block"><%= p.transaction_id || p.id %></span>
                    <span class="text-[10px] text-slate-400 font-mono">
                      <%= p.created_at ? new Date(p.created_at).toLocaleString() : 'Recent' %>
                    </span>
                  </td>

                  <td class="py-3.5 px-4 font-mono font-semibold text-slate-700">
                    <%= p.order_number || p.order_id %>
                  </td>

                  <td class="py-3.5 px-4">
                    <div class="font-bold text-slate-800"><%= p.customer_name || 'Customer' %></div>
                    <div class="text-[11px] text-slate-400 font-mono"><%= p.customer_email %></div>
                  </td>

                  <td class="py-3.5 px-4">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-100 text-slate-700 uppercase">
                      <span class="material-symbols-outlined text-[15px]">credit_card</span>
                      <span><%= p.payment_method || 'UPI Instant' %></span>
                    </span>
                  </td>

                  <td class="py-3.5 px-4 font-mono font-bold text-slate-900 text-sm">
                    ₹<%= (p.amount || 0).toLocaleString('en-IN') %>
                  </td>

                  <td class="py-3.5 px-4">
                    <% 
                      const st = (p.payment_status || p.status || 'SUCCESS').toUpperCase();
                      let statusBadge = 'bg-emerald-50 text-emerald-600 border border-emerald-200';
                      if (st === 'PENDING') statusBadge = 'bg-amber-50 text-amber-600 border border-amber-200';
                      else if (st === 'FAILED') statusBadge = 'bg-red-50 text-red-600 border border-red-200';
                      else if (st === 'REFUNDED') statusBadge = 'bg-purple-50 text-purple-600 border border-purple-200';
                    %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= statusBadge %>">
                      <%= st %>
                    </span>
                  </td>

                  <td class="py-3.5 px-4 text-right">
                    <form method="POST" action="/admin/payments/<%= p.id %>/status" class="inline-flex items-center gap-1">
                      <select name="status" class="px-2 py-1 text-[11px] bg-slate-50 border border-slate-200 rounded-lg text-slate-700 focus:outline-none">
                        <option value="SUCCESS" <%= st === 'SUCCESS' ? 'selected' : '' %>>Settled</option>
                        <option value="PENDING" <%= st === 'PENDING' ? 'selected' : '' %>>Pending</option>
                        <option value="REFUNDED" <%= st === 'REFUNDED' ? 'selected' : '' %>>Refund</option>
                      </select>
                      <button type="submit" class="px-2 py-1 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-[11px] font-semibold transition-colors">
                        Save
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="py-12 text-center text-slate-400">
                  <span class="material-symbols-outlined text-[32px] text-slate-300 block mb-2">payments</span>
                  <p class="font-medium text-sm text-slate-600">No payment records found.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/admin-footer') %>
