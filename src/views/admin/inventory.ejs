<%- include('../partials/admin-header', { title: 'Inventory Management & Stock Audit - Neleeri Sneakers' }) %>
<%- include('../partials/admin-sidebar', { activePage: 'inventory', activeSection: 'Catalog' }) %>
<%- include('../partials/admin-topbar', { activePage: 'inventory', activeSection: 'Catalog' }) %>

<main id="adminMainContent" class="transition-all duration-300 lg:pl-64 pt-16 min-h-screen bg-slate-50">
  <div class="p-6 md:p-8 max-w-7xl mx-auto space-y-6">
    
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold font-heading text-slate-900 tracking-tight">Sneaker Inventory &amp; Stock Movements</h1>
        <p class="text-sm text-slate-500 mt-1">Live size-wise stock allocation, automated replenishment thresholds, and inventory audit logs.</p>
      </div>

      <div class="flex items-center gap-3">
        <a 
          href="/admin/variants" 
          class="inline-flex items-center gap-2 px-3.5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl border border-slate-200 shadow-xs transition-colors"
        >
          <span class="material-symbols-outlined text-[18px]">style</span>
          <span>View All Variants</span>
        </a>
        <button 
          type="button" 
          onclick="openModal('stockAdjustModal')" 
          class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl shadow-sm transition-all"
        >
          <span class="material-symbols-outlined text-[18px]">tune</span>
          <span>Stock Adjustment</span>
        </button>
      </div>
    </div>

    <!-- Inventory Telemetry KPI Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Total Units in Hub</span>
        <div class="text-2xl font-bold text-slate-900 font-heading mt-2">
          <%= totalStockUnits %> <span class="text-xs font-normal text-slate-400">Pairs</span>
        </div>
        <span class="text-[11px] text-blue-600 font-medium mt-1 block">Central Hub Allocation</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Low Stock Alerts</span>
        <div class="text-2xl font-bold text-amber-600 font-heading mt-2">
          <%= lowStockCount %> <span class="text-xs font-normal text-slate-400">Critical</span>
        </div>
        <span class="text-[11px] text-amber-500 font-medium mt-1 block">Buffer threshold: ≤ 15 units</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Depleted Stock</span>
        <div class="text-2xl font-bold text-red-600 font-heading mt-2">
          <%= outOfStockCount %> <span class="text-xs font-normal text-slate-400">Zero Stock</span>
        </div>
        <span class="text-[11px] text-red-500 font-medium mt-1 block">Immediate Restock Required</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200/90 shadow-card">
        <span class="text-xs font-medium text-slate-500 uppercase">Stock Audit Trail</span>
        <div class="text-2xl font-bold text-indigo-600 font-heading mt-2">
          <%= logs.length %> <span class="text-xs font-normal text-slate-400">Events</span>
        </div>
        <span class="text-[11px] text-indigo-500 font-medium mt-1 block">100% Validated in Logs</span>
      </div>
    </div>

    <!-- Variants Live Stock Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 class="text-base font-bold text-slate-900 font-heading">Active Variant Stock Allocation</h2>
          <p class="text-xs text-slate-500 mt-0.5">Real-time inventory levels by size run, colorway, and warehouse SKU.</p>
        </div>
        <form method="GET" action="/admin/inventory" class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">search</span>
          <input 
            type="text" 
            name="search" 
            value="<%= searchQuery || '' %>"
            placeholder="Search variant SKU or sneaker..."
            class="pl-9 pr-4 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800"
          />
        </form>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-slate-500 uppercase tracking-wider text-[11px] border-b border-slate-100 bg-slate-50/70">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Silhouette Name</th>
              <th class="py-3.5 px-4 font-semibold">SKU Identifier</th>
              <th class="py-3.5 px-4 font-semibold">Size</th>
              <th class="py-3.5 px-4 font-semibold">Colorway</th>
              <th class="py-3.5 px-4 font-semibold">Units in Hub</th>
              <th class="py-3.5 px-4 font-semibold">Inventory Status</th>
              <th class="py-3.5 px-4 font-semibold text-right">Quick Restock</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% (variants || []).forEach(v => { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-3.5 px-4 font-bold text-slate-900">
                  <%= v.product_name || 'Neleeri Sneaker' %>
                </td>
                <td class="py-3.5 px-4 font-mono font-semibold text-slate-700">
                  <%= v.sku %>
                </td>
                <td class="py-3.5 px-4">
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-800 font-mono font-bold text-[11px]">
                    <%= v.size %>
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full border border-slate-300 shadow-2xs" style="background-color: <%= v.color_code || '#0f172a' %>"></span>
                    <span class="text-slate-800 font-medium"><%= v.color %></span>
                  </div>
                </td>
                <td class="py-3.5 px-4 font-mono font-bold text-slate-900">
                  <%= v.stock_quantity %> pairs
                </td>
                <td class="py-3.5 px-4">
                  <% 
                    let statusBadge = 'bg-emerald-50 text-emerald-600 border border-emerald-200';
                    let statusText = 'HEALTHY';
                    if (v.stock_quantity <= 0) {
                      statusBadge = 'bg-red-50 text-red-600 border border-red-200';
                      statusText = 'DEPLETED';
                    } else if (v.stock_quantity <= (v.low_stock_threshold || 10)) {
                      statusBadge = 'bg-amber-50 text-amber-600 border border-amber-200';
                      statusText = 'LOW STOCK';
                    }
                  %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase <%= statusBadge %>">
                    <%= statusText %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button 
                    type="button" 
                    onclick="openAdjustForVariant('<%= v.id %>', '<%= v.sku %>', <%= v.stock_quantity %>)"
                    class="px-2.5 py-1 bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-700 rounded-lg text-xs font-semibold transition-colors"
                  >
                    Adjust
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Inventory Logs Audit Trail Card -->
    <div class="bg-white rounded-2xl border border-slate-200/90 shadow-card overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900 font-heading">Inventory Movement Audit Trail</h2>
          <p class="text-xs text-slate-500 mt-0.5">Immutable record of all stock adjustments, purchases, and admin modifications.</p>
        </div>
        <span class="text-xs font-mono text-slate-400">TABLE: inventory_logs</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-slate-500 uppercase tracking-wider text-[11px] border-b border-slate-100 bg-slate-50/70">
            <tr>
              <th class="py-3.5 px-4 font-semibold">Timestamp</th>
              <th class="py-3.5 px-4 font-semibold">Variant SKU</th>
              <th class="py-3.5 px-4 font-semibold">Quantity Delta</th>
              <th class="py-3.5 px-4 font-semibold">Resulting Stock</th>
              <th class="py-3.5 px-4 font-semibold">Movement Reason</th>
              <th class="py-3.5 px-4 font-semibold">Admin Operator</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (logs && logs.length > 0) { %>
              <% logs.slice(0, 10).forEach(log => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-4 font-mono text-slate-500">
                    <%= log.created_at ? new Date(log.created_at).toLocaleString() : 'Just now' %>
                  </td>
                  <td class="py-3.5 px-4 font-mono font-semibold text-slate-800">
                    <%= log.sku || log.variant_id %>
                  </td>
                  <td class="py-3.5 px-4 font-mono font-bold">
                    <% if (log.quantity_change > 0) { %>
                      <span class="text-emerald-600">+<%= log.quantity_change %> units</span>
                    <% } else { %>
                      <span class="text-red-600"><%= log.quantity_change %> units</span>
                    <% } %>
                  </td>
                  <td class="py-3.5 px-4 font-mono text-slate-700">
                    <%= log.new_stock !== undefined ? log.new_stock + ' pairs' : '—' %>
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-slate-100 text-slate-700">
                      <%= log.reason || 'MANUAL_RESTOCK' %>
                    </span>
                  </td>
                  <td class="py-3.5 px-4 text-slate-700 font-medium">
                    <%= log.admin_name || 'Admin Operator' %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="py-8 text-center text-slate-400">No inventory movements recorded yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>

<!-- Modal: Stock Adjustment -->
<div id="stockAdjustModal" class="hidden fixed inset-0 z-50 overflow-y-auto modal-backdrop flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-elevated border border-slate-200">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-base font-bold text-slate-900 font-heading">Stock Level Adjustment</h3>
        <p class="text-xs text-slate-500">Record stock addition, reduction, or inventory reconciliation.</p>
      </div>
      <button onclick="closeModal('stockAdjustModal')" class="text-slate-400 hover:text-slate-600 p-1">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form method="POST" action="/admin/inventory/adjust" class="space-y-4 mt-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Target Variant *</label>
        <select id="adjust_variant_id" name="variant_id" required class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800">
          <% (variants || []).forEach(v => { %>
            <option value="<%= v.id %>"><%= v.product_name %> — <%= v.sku %> (<%= v.size %> - <%= v.color %>) [Current: <%= v.stock_quantity %>]</option>
          <% }) %>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Adjustment Type *</label>
          <select name="type" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800">
            <option value="add">Add (+ Stock)</option>
            <option value="subtract">Deduct (- Stock)</option>
            <option value="set">Direct Set (= Quantity)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Quantity Units *</label>
          <input type="number" name="quantity" required min="1" value="10" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Movement Reason *</label>
        <select name="reason" required class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800">
          <option value="RESTOCK_FACTORY_BATCH">Factory Production Drop / Restock</option>
          <option value="CYCLE_COUNT_AUDIT">Warehouse Cycle Count Reconciliation</option>
          <option value="DAMAGED_TRANSIT_WRITE_OFF">Damaged / Quality Inspection Quarantine</option>
          <option value="CUSTOMER_RETURN_RESTOCK">Customer Return Back into Hub</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Operator Notes</label>
        <textarea name="notes" rows="2" placeholder="Audit log details for compliance verification..." class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:border-blue-600 text-slate-800"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
        <button type="button" onclick="closeModal('stockAdjustModal')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">
          Cancel
        </button>
        <button type="submit" class="px-5 py-2 text-xs font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-sm transition-all">
          Execute Adjustment
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAdjustForVariant(variantId, sku, currentStock) {
    const sel = document.getElementById('adjust_variant_id');
    if (sel) sel.value = variantId;
    openModal('stockAdjustModal');
  }
</script>

<%- include('../partials/admin-footer') %>
