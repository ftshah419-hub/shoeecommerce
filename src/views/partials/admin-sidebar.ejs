<aside 
  id="adminSidebar" 
  class="fixed left-0 top-0 h-full w-64 bg-slate-900 border-r border-slate-800 z-50 flex flex-col justify-between transition-all duration-300 select-none shadow-xl"
>
  <!-- Top Brand & Navigation -->
  <div class="flex flex-col h-[calc(100vh-80px)] overflow-y-auto">
    <!-- Brand Header -->
    <div class="px-6 py-5 flex items-center justify-between border-b border-slate-800/80 bg-slate-950/40">
      <a href="/admin/dashboard" class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
          <span class="material-symbols-outlined text-[20px]">sports_martial_arts</span>
        </div>
        <div class="flex flex-col">
          <span class="font-heading font-bold text-base tracking-wider text-white">NELEERI</span>
          <span class="text-[10px] tracking-widest text-blue-400 font-semibold uppercase">Sneaker Admin</span>
        </div>
      </a>
      <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-mono text-[10px] font-semibold flex items-center gap-1 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>LIVE
      </span>
    </div>

    <!-- Navigation Sections -->
    <div class="px-4 py-4 space-y-6">
      
      <!-- 1. DASHBOARD -->
      <div>
        <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Dashboard
        </div>
        <nav class="space-y-1">
          <a 
            href="/admin/dashboard" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">grid_view</span>
              <span>Overview</span>
            </div>
            <% if (typeof activePage !== 'undefined' && activePage === 'dashboard') { %>
              <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
            <% } %>
          </a>
        </nav>
      </div>

      <!-- 2. CATALOG -->
      <% if (typeof hasPermission === 'undefined' || hasPermission('view_products') || (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'super_admin'))) { %>
      <div>
        <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Catalog
        </div>
        <nav class="space-y-1">
          <a 
            href="/admin/products" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'products' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">inventory_2</span>
              <span>Products</span>
            </div>
          </a>

          <a 
            href="/admin/categories" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'categories' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">category</span>
              <span>Categories</span>
            </div>
          </a>

          <a 
            href="/admin/variants" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'variants' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">style</span>
              <span>Product Variants</span>
            </div>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-800 text-slate-300">Sizes</span>
          </a>

          <a 
            href="/admin/inventory" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'inventory' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">warehouse</span>
              <span>Inventory</span>
            </div>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">Stock</span>
          </a>
        </nav>
      </div>
      <% } %>

      <!-- 3. SALES -->
      <% if (typeof hasPermission === 'undefined' || hasPermission('view_orders') || (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'super_admin' || currentUser.role === 'operations_manager'))) { %>
      <div>
        <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Sales
        </div>
        <nav class="space-y-1">
          <a 
            href="/admin/orders" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">shopping_bag</span>
              <span>Orders</span>
            </div>
            <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-orange-500 text-white">Active</span>
          </a>

          <a 
            href="/admin/payments" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'payments' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">credit_card</span>
              <span>Payments</span>
            </div>
          </a>

          <a 
            href="/admin/shipments" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'shipments' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">local_shipping</span>
              <span>Shipments</span>
            </div>
          </a>

          <a 
            href="/admin/coupons" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'coupons' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">confirmation_number</span>
              <span>Coupons</span>
            </div>
          </a>
        </nav>
      </div>
      <% } %>

      <!-- 4. CUSTOMERS -->
      <% if (typeof hasPermission === 'undefined' || hasPermission('view_customers') || (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'super_admin' || currentUser.role === 'customer_support'))) { %>
      <div>
        <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Customers
        </div>
        <nav class="space-y-1">
          <a 
            href="/admin/customers" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">group</span>
              <span>Customers</span>
            </div>
          </a>

          <a 
            href="/admin/reviews" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'reviews' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">reviews</span>
              <span>Reviews</span>
            </div>
          </a>

          <a 
            href="/admin/messages" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'messages' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">chat</span>
              <span>Contact Messages</span>
            </div>
          </a>
        </nav>
      </div>
      <% } %>

      <!-- 5. ADMINISTRATION -->
      <% if (typeof hasPermission === 'undefined' || hasPermission('manage_system') || hasPermission('manage_users') || (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'admin' || currentUser.role === 'super_admin'))) { %>
      <div>
        <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Administration
        </div>
        <nav class="space-y-1">
          <a 
            href="/admin/admin-users" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'admin-users' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">badge</span>
              <span>Admin Users</span>
            </div>
          </a>

          <a 
            href="/admin/roles" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && (activePage === 'roles' || activePage === 'permissions') ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">shield_person</span>
              <span>Roles &amp; Permissions</span>
            </div>
          </a>

          <a 
            href="/admin/activity-logs" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'activity-logs' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">history</span>
              <span>Activity Logs</span>
            </div>
          </a>
        </nav>
      </div>
      <% } %>

      <!-- 6. SETTINGS -->
      <div>
        <div class="px-3 mb-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
          Settings
        </div>
        <nav class="space-y-1">
          <a 
            href="/admin/settings" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm transition-all <%= typeof activePage !== 'undefined' && activePage === 'settings' ? 'bg-blue-600 text-white font-semibold shadow-md shadow-blue-600/30' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">settings</span>
              <span>Profile</span>
            </div>
          </a>

          <a 
            href="/auth/logout" 
            class="flex items-center justify-between px-3 py-2 rounded-xl text-sm text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-all"
          >
            <div class="flex items-center gap-3">
              <span class="material-symbols-outlined text-[19px]">logout</span>
              <span>Logout</span>
            </div>
          </a>
        </nav>
      </div>

    </div>
  </div>

  <!-- Bottom Admin Operator Card & Storefront link -->
  <div class="p-3 border-t border-slate-800/80 bg-slate-950/60">
    <div class="flex items-center justify-between p-2 rounded-xl bg-slate-800/60 border border-slate-700/50">
      <div class="flex items-center gap-2.5 overflow-hidden">
        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold shrink-0">
          <%= typeof currentUser !== 'undefined' && currentUser && currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'A' %>
        </div>
        <div class="truncate">
          <p class="text-xs font-semibold text-white truncate">
            <%= typeof currentUser !== 'undefined' && currentUser && currentUser.name ? currentUser.name : 'Administrator' %>
          </p>
          <span class="text-[10px] text-slate-400 uppercase font-mono">
            <%= typeof currentUser !== 'undefined' && currentUser && currentUser.role ? currentUser.role : 'SUPER_ADMIN' %>
          </span>
        </div>
      </div>
      <a 
        href="/" 
        target="_blank" 
        title="View Live Storefront" 
        class="w-7 h-7 rounded-lg bg-slate-700/80 hover:bg-blue-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors"
      >
        <span class="material-symbols-outlined text-[16px]">open_in_new</span>
      </a>
    </div>
  </div>
</aside>
