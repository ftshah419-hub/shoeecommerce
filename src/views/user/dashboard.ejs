<%- include('partials/header', { title: 'User Command Dashboard - Neleeri Sneakers' }) %>
<%- include('partials/user-hero', { activeTab: 'dashboard' }) %>

<main class="w-full px-4 md:px-12 py-8 space-y-10">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-primary-container/20 border border-primary text-primary px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span class="font-label-tech text-xs"><%= success %></span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-on-surface hover:text-white">&times;</button>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-error-container/30 border border-error text-error px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">error</span>
        <span class="font-label-tech text-xs"><%= error %></span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-on-surface hover:text-white">&times;</button>
    </div>
  <% } %>

  <!-- SECTION 1: Active Dispatches & Live Transit HUD -->
  <% if (typeof activeOrder !== 'undefined' && activeOrder) { %>
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
        <div>
          <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[LOG_01 // PRIORITY TRANSIT]</span>
          <h2 class="font-headline-lg text-2xl uppercase text-on-surface tracking-tight font-bold">Active Dispatch Tracking</h2>
        </div>
        <div class="flex items-center gap-2 font-label-tech text-xs text-secondary">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-secondary animate-ping"></span>
          <span>LIVE SATELLITE TELEMETRY</span>
        </div>
      </div>

      <div class="bg-surface-container-low p-6 lg:p-8 relative overflow-hidden shadow-lg border border-outline-variant/30">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary-container/10 -mr-10 -mt-10 rounded-full blur-2xl"></div>
        
        <!-- Order Meta Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b border-outline-variant/20">
          <div class="flex flex-wrap items-center gap-3">
            <div class="bg-surface-container px-3 py-1 font-label-tech text-xs text-primary uppercase font-bold tracking-wider border border-primary/30">
              <%= activeOrder.order_number %>
            </div>
            <span class="font-label-tech text-xs text-on-surface-variant">
              DATE: <%= new Date(activeOrder.created_at).toLocaleDateString() %>
            </span>
            <span class="w-1 h-1 rounded-full bg-outline-variant hidden sm:inline-block"></span>
            <span class="font-label-tech text-xs text-on-surface-variant">
              TOTAL: $<%= Number(activeOrder.total_amount).toFixed(2) %> [<%= activeOrder.payment_status %>]
            </span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-label-caps text-xs uppercase px-3 py-1 bg-secondary-container text-on-secondary font-bold">
              <%= activeOrder.order_status %>
            </span>
          </div>
        </div>

        <!-- Product Preview & Tracking Progress Bar Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center pt-6">
          <!-- Sneaker Items Preview -->
          <div class="lg:col-span-6 flex flex-col sm:flex-row items-center gap-4">
            <div class="flex -space-x-3 items-center overflow-hidden">
              <% (activeOrder.items || []).forEach((item, idx) => { %>
                <div class="w-20 h-20 bg-surface-container overflow-hidden shadow-md flex-shrink-0 relative group border border-outline-variant/40">
                  <img class="w-full h-full object-cover transition-transform group-hover:scale-110" 
                       src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=400&q=80" 
                       alt="<%= item.product_name %>" />
                  <span class="absolute top-1 left-1 font-label-tech text-[9px] bg-surface-container-lowest/90 px-1 text-on-surface font-mono">
                    #<%= idx + 1 %>
                  </span>
                </div>
              <% }) %>
            </div>

            <div class="flex flex-col gap-1 text-center sm:text-left">
              <h3 class="font-headline-sm text-lg uppercase text-on-surface font-bold">
                <%= (activeOrder.items && activeOrder.items.length > 0) ? activeOrder.items.map(i => i.product_name).join(' + ') : 'Neleeri Performance Sneaker' %>
              </h3>
              <p class="text-xs text-on-surface-variant">
                <% if (activeOrder.items && activeOrder.items.length > 0) { %>
                  Size: <%= activeOrder.items[0].size %> // Qty: <%= activeOrder.items.reduce((s, i) => s + (i.quantity || 1), 0) %>
                <% } %>
              </p>
              <% if (activeOrder.shipment) { %>
                <div class="flex items-center justify-center sm:justify-start gap-2 pt-1 font-label-tech text-xs text-secondary">
                  <span>[<%= activeOrder.shipment.courier_name %> // <%= activeOrder.shipment.tracking_number %>]</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Visual Progress HUD Bar -->
          <div class="lg:col-span-4 flex flex-col justify-center gap-2 bg-surface-container/40 p-4 border border-outline-variant/30">
            <div class="flex justify-between font-label-tech text-[10px] uppercase text-on-surface-variant">
              <span class="text-primary font-bold">DEPOT DISPATCH</span>
              <span class="text-secondary font-bold">AIR EXPRESS HUB</span>
              <span>DESTINATION</span>
            </div>
            
            <!-- Segmented Progress Bar -->
            <div class="w-full h-2.5 bg-surface-container grid grid-cols-3 gap-1 overflow-hidden">
              <div class="h-full bg-primary-container"></div>
              <div class="h-full bg-secondary-container animate-pulse"></div>
              <div class="h-full bg-surface-container-high"></div>
            </div>

            <div class="flex justify-between font-label-tech text-[10px] text-tertiary">
              <span><%= activeOrder.address ? activeOrder.address.city : 'CENTRAL HUB' %></span>
              <span><%= (activeOrder.shipment && activeOrder.shipment.estimated_delivery) ? 'EST: ' + activeOrder.shipment.estimated_delivery : 'IN PROGRESS' %></span>
            </div>
          </div>

          <!-- Action CTAs -->
          <div class="lg:col-span-2 flex flex-col gap-2 justify-center">
            <a href="/user/profile" class="w-full bg-primary-container text-on-primary py-2.5 px-3 font-label-caps text-xs uppercase hover:bg-inverse-primary transition-colors flex items-center justify-center gap-2 shadow-md">
              <span class="material-symbols-outlined text-[16px]">radar</span>
              <span>View Manifest</span>
            </a>
            <a href="/products" class="w-full bg-surface-container hover:bg-surface-container-high text-on-surface py-2.5 px-3 font-label-caps text-xs uppercase transition-colors flex items-center justify-center gap-2 text-center">
              <span class="material-symbols-outlined text-[16px]">shopping_bag</span>
              <span>Order More</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  <% } %>

  <!-- SECTION 2: Complete Orders Archive (From orders & order_items tables) -->
  <section class="space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[LOG_02 // SHIPMENT REGISTRY]</span>
        <h2 class="font-headline-lg text-2xl uppercase text-on-surface tracking-tight font-bold">Order History Archive</h2>
      </div>
      <span class="font-label-tech text-xs text-tertiary uppercase">
        <%= orders ? orders.length : 0 %> TOTAL RECORDS STORED
      </span>
    </div>

    <% if (orders && orders.length > 0) { %>
      <div class="grid grid-cols-1 gap-4">
        <% orders.forEach(order => { %>
          <div class="bg-surface-container-low p-5 lg:p-6 shadow-sm border border-outline-variant/30 transition-all hover:border-primary/50">
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-outline-variant/20">
              <div class="flex flex-wrap items-center gap-3">
                <span class="bg-surface-container px-2.5 py-1 font-label-tech text-xs text-on-surface uppercase font-bold tracking-wider">
                  <%= order.order_number %>
                </span>
                <span class="font-label-tech text-xs text-on-surface-variant">
                  <%= new Date(order.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                </span>
                <span class="w-1 h-1 rounded-full bg-outline-variant hidden sm:inline-block"></span>
                <span class="font-label-tech text-xs text-on-surface-variant font-mono">
                  TOTAL: $<%= Number(order.total_amount).toFixed(2) %> (<%= order.payment_status %>)
                </span>
              </div>
              <div class="flex items-center gap-2">
                <span class="font-label-caps text-xs uppercase px-2.5 py-1 <%= order.order_status === 'DELIVERED' ? 'bg-surface-container-high text-primary-fixed-dim' : 'bg-secondary-container text-on-secondary' %> font-bold">
                  <%= order.order_status %>
                </span>
              </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-center pt-4">
              <div class="lg:col-span-7 flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <div class="w-16 h-16 bg-surface-container overflow-hidden shadow-sm flex-shrink-0 border border-outline-variant/30">
                  <img class="w-full h-full object-cover" 
                       src="https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?auto=format&fit=crop&w=400&q=80" 
                       alt="Sneaker" />
                </div>
                <div class="flex flex-col gap-1">
                  <h4 class="font-headline-sm text-base uppercase text-on-surface font-semibold">
                    <% if (order.items && order.items.length > 0) { %>
                      <%= order.items.map(i => i.product_name).join(', ') %>
                    <% } else { %>
                      Neleeri Custom Drop
                    <% } %>
                  </h4>
                  <p class="text-xs text-on-surface-variant">
                    <% if (order.items && order.items.length > 0) { %>
                      Items: <%= order.items.length %> &bull; Size: <%= order.items[0].size %> &bull; SKU: <%= order.items[0].sku %>
                    <% } %>
                  </p>
                </div>
              </div>

              <div class="lg:col-span-5 flex flex-wrap items-center justify-end gap-2">
                <a href="/products" class="bg-surface-container hover:bg-surface-container-high text-on-surface py-2 px-3 font-label-caps text-xs uppercase transition-colors flex items-center gap-1">
                  <span class="material-symbols-outlined text-[15px]">replay</span>
                  <span>Buy Again</span>
                </a>
                <a href="/user/profile" class="bg-primary-container text-on-primary py-2 px-3 font-label-caps text-xs uppercase hover:bg-inverse-primary transition-colors flex items-center gap-1">
                  <span class="material-symbols-outlined text-[15px]">visibility</span>
                  <span>View Details</span>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-surface-container-low p-12 text-center border border-outline-variant/30 space-y-4">
        <span class="material-symbols-outlined text-4xl text-tertiary">inventory_2</span>
        <h3 class="font-headline-md text-xl uppercase text-on-surface">No Orders Recorded</h3>
        <p class="text-xs text-on-surface-variant max-w-sm mx-auto">Your tactical locker is waiting for its first drop. Explore our sneaker catalog to begin.</p>
        <a href="/products" class="inline-block bg-primary-container text-on-primary px-6 py-2.5 font-label-caps text-xs uppercase font-bold">
          Explore Sneaker Catalog
        </a>
      </div>
    <% } %>
  </section>

  <!-- SECTION 3: Tactical Addresses & Account Preferences Quick View -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Saved Street Addresses Preview -->
    <div class="lg:col-span-7 bg-surface-container-low p-6 border border-outline-variant/30 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[GEO_03 // NODES]</span>
          <h3 class="font-headline-sm text-lg uppercase text-on-surface font-bold">Primary Dispatch Coordinate</h3>
        </div>
        <a href="/user/settings" class="font-label-caps text-xs uppercase text-primary hover:underline">
          Manage All (<%= addresses ? addresses.length : 0 %>) &rarr;
        </a>
      </div>

      <% if (defaultAddress) { %>
        <div class="bg-surface-container p-4 border border-outline-variant/30 space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-label-caps text-[10px] uppercase px-2 py-0.5 bg-primary-container text-on-primary font-bold">
              DEFAULT <%= defaultAddress.address_type %>
            </span>
            <span class="material-symbols-outlined text-primary text-[18px]">verified</span>
          </div>
          <p class="font-headline-sm text-sm uppercase text-on-surface font-bold"><%= defaultAddress.full_name %></p>
          <p class="text-xs text-on-surface-variant leading-relaxed">
            <%= defaultAddress.address_line1 %><br/>
            <% if (defaultAddress.address_line2) { %><%= defaultAddress.address_line2 %><br/><% } %>
            <%= defaultAddress.city %>, <%= defaultAddress.state %> — <%= defaultAddress.postal_code %>, <%= defaultAddress.country %>
          </p>
          <p class="font-label-tech text-xs text-tertiary">TEL: <%= defaultAddress.phone %></p>
        </div>
      <% } else { %>
        <p class="text-xs text-on-surface-variant">No saved address yet.</p>
        <a href="/user/settings" class="inline-block text-xs uppercase text-primary font-bold">+ Register Address</a>
      <% } %>
    </div>

    <!-- Squad VIP Access & Lab Drop -->
    <div class="lg:col-span-5 bg-surface-container-low p-6 border border-outline-variant/30 flex flex-col justify-between space-y-4 relative overflow-hidden">
      <div class="absolute -bottom-8 -right-8 w-24 h-24 bg-secondary-container/20 rounded-full blur-xl pointer-events-none"></div>
      <div>
        <div class="flex items-center gap-2 font-label-tech text-xs text-secondary pb-1">
          <span class="material-symbols-outlined text-[16px]">military_tech</span>
          <span class="tracking-widest uppercase">BLACK PASS PRIVILEGE</span>
        </div>
        <h4 class="font-headline-sm text-lg uppercase text-on-surface font-bold">Secret Lab Drop: 28 OCT</h4>
        <p class="text-xs text-on-surface-variant mt-2 leading-relaxed">
          Your Level 3 membership permits 15-minute priority whitelist access prior to the global public drop.
        </p>
      </div>

      <div class="bg-surface-container p-3 flex items-center justify-between font-label-tech text-xs border border-outline-variant/30">
        <span class="text-tertiary">TOKEN CODE:</span>
        <span class="text-primary-fixed-dim font-bold tracking-widest font-mono">#BLK-9982-IN</span>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
