<%- include('partials/header', { title: 'User Profile & Identity - Neleeri Sneakers' }) %>
<%- include('partials/user-hero', { activeTab: 'profile' }) %>

<main class="w-full px-4 md:px-12 py-8 space-y-10">

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-primary-container/20 border border-primary text-primary px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span class="font-label-tech text-xs"><%= success %></span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-on-surface hover:text-white">&times;</button>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-error-container/30 border border-error text-error px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">error</span>
        <span class="font-label-tech text-xs"><%= error %></span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-on-surface hover:text-white">&times;</button>
    </div>
  <% } %>

  <% if (typeof orderSuccess !== 'undefined' && orderSuccess) { %>
    <div class="bg-primary-container/20 border border-primary text-primary px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-[20px]">celebration</span>
        <span class="font-label-tech text-xs">ORDER CONFIRMED: <strong>#<%= orderSuccess %></strong>. DISPATCH PIPELINE ACTIVATED.</span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-on-surface hover:text-white">&times;</button>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- LEFT COLUMN: Profile Overview & Edit Form -->
    <div class="lg:col-span-7 space-y-8">
      
      <!-- Card 1: Identity & ERD User Schema Fields -->
      <section class="bg-surface-container-low p-6 lg:p-8 border border-outline-variant/30 space-y-6">
        <div class="flex items-center justify-between border-b border-outline-variant/20 pb-4">
          <div>
            <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[ENTITY // USERS TABLE]</span>
            <h2 class="font-headline-lg text-xl uppercase text-on-surface tracking-tight font-bold">Profile Identity Specs</h2>
          </div>
          <span class="font-label-caps text-xs uppercase px-2 py-0.5 bg-primary-container text-on-primary font-bold">
            <%= user.account_status || 'ACTIVE' %>
          </span>
        </div>

        <!-- Read-Only / Schema Metadata Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-surface-container p-3 border border-outline-variant/20 space-y-1">
            <span class="font-label-tech text-[10px] text-tertiary uppercase block">Primary Key (id)</span>
            <span class="font-mono text-xs text-primary font-bold"><%= user.id %></span>
          </div>

          <div class="bg-surface-container p-3 border border-outline-variant/20 space-y-1">
            <span class="font-label-tech text-[10px] text-tertiary uppercase block">Account Status</span>
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-primary-container"></span>
              <span class="font-label-tech text-xs text-on-surface uppercase"><%= user.account_status || 'ACTIVE' %></span>
            </div>
          </div>

          <div class="bg-surface-container p-3 border border-outline-variant/20 space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-label-tech text-[10px] text-tertiary uppercase block">Email Address (email)</span>
              <% if (user.email_verified) { %>
                <span class="font-label-tech text-[9px] text-primary flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-[11px]">verified</span> VERIFIED
                </span>
              <% } %>
            </div>
            <span class="text-xs text-on-surface font-semibold truncate block"><%= user.email %></span>
          </div>

          <div class="bg-surface-container p-3 border border-outline-variant/20 space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-label-tech text-[10px] text-tertiary uppercase block">Phone (phone)</span>
              <% if (user.phone_verified) { %>
                <span class="font-label-tech text-[9px] text-secondary flex items-center gap-0.5">
                  <span class="material-symbols-outlined text-[11px]">lock</span> 2FA ACTIVE
                </span>
              <% } %>
            </div>
            <span class="text-xs text-on-surface font-semibold truncate block"><%= user.phone || 'Not Configured' %></span>
          </div>

          <div class="bg-surface-container p-3 border border-outline-variant/20 space-y-1">
            <span class="font-label-tech text-[10px] text-tertiary uppercase block">Enlistment Date (created_at)</span>
            <span class="font-label-tech text-xs text-on-surface-variant font-mono">
              <%= new Date(user.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </span>
          </div>

          <div class="bg-surface-container p-3 border border-outline-variant/20 space-y-1">
            <span class="font-label-tech text-[10px] text-tertiary uppercase block">Last Synchronization (updated_at)</span>
            <span class="font-label-tech text-xs text-on-surface-variant font-mono">
              <%= new Date(user.updated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
            </span>
          </div>
        </div>
      </section>

      <!-- Card 2: Edit Profile Form (Updates users table via POST/PUT /user/profile) -->
      <section id="edit-profile" class="bg-surface-container-low p-6 lg:p-8 border border-outline-variant/30 space-y-6">
        <div class="border-b border-outline-variant/20 pb-4">
          <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[MUTATION // UPDATE PROFILE]</span>
          <h2 class="font-headline-lg text-xl uppercase text-on-surface tracking-tight font-bold">Edit Profile Coordinates</h2>
          <p class="text-xs text-on-surface-variant mt-1">Directly modifies the `users` table entity via `userController.updateProfile`.</p>
        </div>

        <form action="/user/profile" method="POST" class="space-y-4">
          <div>
            <label class="block font-label-tech text-xs uppercase text-tertiary mb-1">
              Full Name (full_name / varchar 150)
            </label>
            <input type="text" name="full_name" value="<%= user.full_name || user.name || '' %>" required
                   class="w-full bg-surface-container px-4 py-2.5 text-xs text-on-surface border border-outline-variant/40 focus:border-primary focus:outline-none transition-colors"
                   placeholder="e.g. Arhan Malhotra" />
          </div>

          <div>
            <label class="block font-label-tech text-xs uppercase text-tertiary mb-1">
              Phone Number (phone / varchar 30)
            </label>
            <input type="text" name="phone" value="<%= user.phone || '' %>"
                   class="w-full bg-surface-container px-4 py-2.5 text-xs text-on-surface border border-outline-variant/40 focus:border-primary focus:outline-none transition-colors"
                   placeholder="e.g. +91 98200 12345" />
          </div>

          <div>
            <label class="block font-label-tech text-xs uppercase text-tertiary mb-1">
              Profile Avatar URL (profile_image / varchar 500)
            </label>
            <input type="url" name="profile_image" value="<%= user.profile_image || '' %>"
                   class="w-full bg-surface-container px-4 py-2.5 text-xs text-on-surface border border-outline-variant/40 focus:border-primary focus:outline-none transition-colors"
                   placeholder="https://..." />
          </div>

          <div class="pt-2 flex items-center justify-end gap-3">
            <a href="/user/dashboard" class="px-4 py-2 text-xs uppercase font-label-caps text-on-surface-variant hover:text-on-surface">
              Cancel
            </a>
            <button type="submit" 
                    class="bg-primary-container text-on-primary px-6 py-2.5 font-label-caps text-xs uppercase font-bold hover:bg-inverse-primary transition-all flex items-center gap-2 shadow-md">
              <span class="material-symbols-outlined text-[16px]">save</span>
              <span>Save Profile Changes</span>
            </button>
          </div>
        </form>
      </section>

    </div>

    <!-- RIGHT COLUMN: Default Address & Quick Manifest Preview -->
    <div class="lg:col-span-5 space-y-8">
      
      <!-- Primary Delivery Address (FK address_id -> addresses table) -->
      <section class="bg-surface-container-low p-6 lg:p-8 border border-outline-variant/30 space-y-4">
        <div class="flex items-center justify-between border-b border-outline-variant/20 pb-4">
          <div>
            <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[ENTITY // ADDRESSES TABLE]</span>
            <h3 class="font-headline-sm text-lg uppercase text-on-surface font-bold">Default Delivery Node</h3>
          </div>
          <a href="/user/settings" class="font-label-caps text-xs uppercase text-primary hover:underline">
            Manage &rarr;
          </a>
        </div>

        <% if (defaultAddress) { %>
          <div class="bg-surface-container p-4 border border-outline-variant/30 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-label-caps text-[10px] uppercase px-2 py-0.5 bg-primary-container text-on-primary font-bold">
                DEFAULT <%= defaultAddress.address_type %>
              </span>
              <span class="material-symbols-outlined text-primary text-[18px]">verified</span>
            </div>
            <h4 class="font-headline-sm text-sm uppercase text-on-surface font-bold"><%= defaultAddress.full_name %></h4>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              <%= defaultAddress.address_line1 %><br/>
              <% if (defaultAddress.address_line2) { %><%= defaultAddress.address_line2 %><br/><% } %>
              <%= defaultAddress.city %>, <%= defaultAddress.state %> — <%= defaultAddress.postal_code %>, <%= defaultAddress.country %>
            </p>
            <div class="pt-2 flex items-center gap-2 font-label-tech text-xs text-on-surface">
              <span class="material-symbols-outlined text-[15px] text-tertiary">call</span>
              <span><%= defaultAddress.phone %></span>
            </div>
          </div>
        <% } else { %>
          <div class="bg-surface-container p-6 text-center border border-outline-variant/30 space-y-2">
            <span class="material-symbols-outlined text-2xl text-tertiary">pin_drop</span>
            <p class="text-xs text-on-surface-variant">No delivery address saved yet.</p>
            <a href="/user/settings" class="inline-block text-xs uppercase text-primary font-bold">+ Register Address</a>
          </div>
        <% } %>
      </section>

      <!-- Quick Recent Orders Snapshot -->
      <section class="bg-surface-container-low p-6 lg:p-8 border border-outline-variant/30 space-y-4">
        <div class="flex items-center justify-between border-b border-outline-variant/20 pb-4">
          <div>
            <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[ENTITY // ORDERS TABLE]</span>
            <h3 class="font-headline-sm text-lg uppercase text-on-surface font-bold">Order Telemetry</h3>
          </div>
          <a href="/user/dashboard" class="font-label-caps text-xs uppercase text-primary hover:underline">
            All (<%= orders ? orders.length : 0 %>) &rarr;
          </a>
        </div>

        <% if (orders && orders.length > 0) { %>
          <div class="space-y-3">
            <% orders.slice(0, 3).forEach(o => { %>
              <div class="bg-surface-container p-3 border border-outline-variant/20 flex items-center justify-between">
                <div>
                  <span class="font-label-tech text-xs text-primary font-bold font-mono"><%= o.order_number %></span>
                  <p class="text-[11px] text-on-surface-variant">
                    <%= new Date(o.created_at).toLocaleDateString() %> &bull; $<%= Number(o.total_amount).toFixed(2) %>
                  </p>
                </div>
                <span class="font-label-caps text-[10px] px-2 py-0.5 bg-surface-container-high text-on-surface font-semibold uppercase">
                  <%= o.order_status %>
                </span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-on-surface-variant">No previous orders recorded.</p>
        <% } %>
      </section>

      <!-- Quick Action Navigation -->
      <section class="bg-surface-container-low p-4 border border-outline-variant/30 flex items-center justify-between font-label-caps text-xs uppercase">
        <a href="/user/dashboard" class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">dashboard</span>
          <span>Command Hub</span>
        </a>
        <span class="text-outline-variant">|</span>
        <a href="/user/settings" class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">settings</span>
          <span>Settings</span>
        </a>
        <span class="text-outline-variant">|</span>
        <a href="/auth/logout" class="text-error hover:underline transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px]">logout</span>
          <span>Sign Out</span>
        </a>
      </section>

    </div>
  </div>

</main>

<%- include('partials/footer') %>
