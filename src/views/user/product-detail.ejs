<%- include('partials/header', { title: `${product.name} - Neleeri Sneaker Specifications` }) %>

<main class="w-full pt-4 bg-background min-h-screen">
  <div class="flex flex-col w-full">
    <!-- Top Utility Context Bar -->
    <section class="w-full bg-surface-container-lowest px-4 md:px-12 py-3 border-b border-surface-container-high">
      <div class="flex flex-wrap items-center justify-between gap-y-2 text-xs font-label-tech max-w-7xl mx-auto w-full">
        <nav class="flex items-center gap-2 text-on-surface-variant uppercase">
          <a class="hover:text-primary transition-colors" href="/">HOME</a>
          <span>/</span>
          <a class="hover:text-primary transition-colors" href="/products">SHOP</a>
          <span>/</span>
          <span class="text-on-surface font-semibold tracking-wider"><%= product.name %></span>
        </nav>
        <div class="flex items-center gap-4 text-on-surface-variant font-mono">
          <span class="bg-surface-container px-2 py-0.5 text-primary">[SKU: NL-<%= product.id.toUpperCase() %>]</span>
          <span class="hidden sm:inline-block text-tertiary">SERIES 04 ARCHIVE</span>
          <span class="flex items-center gap-1.5 text-secondary-container font-bold">
            <span class="w-2 h-2 rounded-full bg-secondary-container animate-ping"></span>
            IN-STOCK // DISPATCH ACTIVE
          </span>
        </div>
      </div>
    </section>

    <!-- Alerts if any -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="max-w-7xl mx-auto w-full px-4 md:px-12 pt-4">
        <div class="bg-error-container/30 border border-error text-error px-4 py-3 flex items-center justify-between text-xs">
          <span><%= error %></span>
          <button onclick="this.parentElement.remove()" class="text-white font-bold">&times;</button>
        </div>
      </div>
    <% } %>

    <!-- Hero Product Showcase (2-Column Dense Grid) -->
    <section class="w-full px-4 md:px-12 py-8 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Sneaker Visual & Thumbnails (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <div class="relative w-full aspect-[4/3] bg-surface-container-lowest overflow-hidden group border border-outline-variant/30 flex items-center justify-center p-8">
            <!-- Badges -->
            <div class="absolute top-4 left-4 z-20 flex flex-wrap gap-2 pointer-events-none">
              <span class="font-label-caps text-[10px] uppercase bg-primary-container text-on-primary px-3 py-1 font-bold shadow-md">
                <%= product.category %>
              </span>
              <span class="font-label-caps text-[10px] uppercase bg-surface-container-high/90 text-on-surface px-3 py-1 border border-outline-variant/30">
                <%= product.brand %>
              </span>
            </div>

            <!-- View 3D Mode Toggle -->
            <div class="absolute top-4 right-4 z-20">
              <button type="button" class="flex items-center gap-1 font-label-caps text-[10px] uppercase px-3 py-1.5 bg-surface-container-highest/90 text-on-surface hover:bg-primary-container hover:text-on-primary transition-all border border-outline-variant/40">
                <span class="material-symbols-outlined text-[15px]">view_in_ar</span>
                <span>3D / AR INSPECT</span>
              </button>
            </div>

            <!-- Main Sneaker Image -->
            <img id="main-image" src="<%= product.image %>" 
                 alt="<%= product.name %>" 
                 class="w-full h-full object-contain filter drop-shadow-[0_20px_25px_rgba(0,0,0,0.8)] transition-transform duration-500 hover:scale-105" />

            <div class="absolute bottom-3 left-3 flex items-center gap-2 font-label-tech text-[10px] text-tertiary bg-surface-container-lowest/80 px-2 py-1 border border-outline-variant/30">
              <span class="material-symbols-outlined text-[13px] text-primary">360</span>
              <span>TACTICAL CHASSIS VIEW</span>
            </div>
          </div>

          <!-- Thumbnail Strip -->
          <div class="grid grid-cols-4 gap-3">
            <button onclick="document.getElementById('main-image').src='<%= product.image %>'" 
                    class="aspect-square bg-surface-container-low border-2 border-primary-container p-2 flex items-center justify-center">
              <img src="<%= product.image %>" alt="Thumbnail" class="w-full h-full object-contain">
            </button>
            <button onclick="document.getElementById('main-image').src='https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=800&q=80'" 
                    class="aspect-square bg-surface-container-low border border-outline-variant/30 hover:border-primary-container p-2 flex items-center justify-center">
              <img src="https://images.unsplash.com/photo-1552346154-21d32810aba3?auto=format&fit=crop&w=800&q=80" alt="Thumbnail" class="w-full h-full object-contain">
            </button>
            <button onclick="document.getElementById('main-image').src='https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?auto=format&fit=crop&w=800&q=80'" 
                    class="aspect-square bg-surface-container-low border border-outline-variant/30 hover:border-primary-container p-2 flex items-center justify-center">
              <img src="https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?auto=format&fit=crop&w=800&q=80" alt="Thumbnail" class="w-full h-full object-contain">
            </button>
            <button onclick="document.getElementById('main-image').src='https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&w=800&q=80'" 
                    class="aspect-square bg-surface-container-low border border-outline-variant/30 hover:border-primary-container p-2 flex items-center justify-center">
              <img src="https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&w=800&q=80" alt="Thumbnail" class="w-full h-full object-contain">
            </button>
          </div>
        </div>

        <!-- Right Column: Specs, Sizing Matrix, Add To Bag (5 cols) -->
        <div class="lg:col-span-5 bg-surface-container-low p-6 lg:p-8 border border-outline-variant/30 space-y-6">
          <div>
            <span class="font-label-tech text-xs uppercase text-secondary tracking-widest block mb-1">
              <%= product.brand %> // ARCHIVE SPEC
            </span>
            <h1 class="font-headline-lg text-2xl sm:text-3xl uppercase text-on-surface tracking-tight font-bold">
              <%= product.name %>
            </h1>
            <div class="flex items-center gap-3 pt-2 text-xs font-label-tech text-on-surface-variant">
              <div class="flex items-center text-secondary">
                <span class="material-symbols-outlined text-[16px]">star</span>
                <span class="font-bold ml-1">5.0</span>
              </div>
              <span>&bull;</span>
              <span>48 VERIFIED BUYER RATINGS</span>
            </div>
          </div>

          <!-- Valuation & Stock Status -->
          <div class="flex items-baseline justify-between border-y border-outline-variant/20 py-4">
            <div class="flex items-baseline gap-2">
              <span class="font-headline-xl text-3xl font-bold font-mono text-on-surface">
                $<%= Number(product.price).toFixed(2) %>
              </span>
              <span class="text-xs font-label-tech text-tertiary">USD // TAX INCLUDED</span>
            </div>
            <span class="font-label-tech text-[10px] uppercase px-2 py-0.5 bg-primary-container/30 text-primary border border-primary/30 font-bold">
              <%= product.stock || 25 %> UNITS IN VAULT
            </span>
          </div>

          <p class="text-xs text-on-surface-variant leading-relaxed">
            <%= product.description %>
          </p>

          <!-- Add to Bag Form -->
          <form action="/cart/add" method="POST" class="space-y-6">
            <input type="hidden" name="productId" value="<%= product.id %>">
            <input type="hidden" id="selected-size-input" name="size" value="<%= (product.sizes && product.sizes.length > 0) ? product.sizes[0] : 9 %>">

            <!-- Shoe Size Selector Matrix -->
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="font-label-caps text-xs uppercase text-on-surface font-bold tracking-wider">
                  Select Footwear Spec (US / UK):
                </span>
                <span id="size-indicator" class="font-label-tech text-xs text-primary font-bold">
                  SIZE: <%= (product.sizes && product.sizes.length > 0) ? product.sizes[0] : 9 %>
                </span>
              </div>

              <div class="grid grid-cols-4 sm:grid-cols-6 gap-2">
                <% (product.sizes || [7, 8, 9, 10, 11, 12]).forEach((sz, idx) => { %>
                  <button type="button" 
                          onclick="selectSize('<%= sz %>')"
                          id="size-btn-<%= sz %>"
                          class="size-pill py-2.5 text-center text-xs font-label-caps border border-outline-variant/40 <%= idx === 0 ? 'bg-primary-container text-on-primary font-bold border-primary shadow-md' : 'bg-surface-container text-on-surface hover:border-primary' %> transition-all">
                    <%= sz %>
                  </button>
                <% }) %>
              </div>
            </div>

            <!-- Quantity & CTAs -->
            <div class="flex items-center gap-3 pt-2">
              <div class="flex items-center border border-outline-variant/40 bg-surface-container">
                <button type="button" onclick="decrementQty()" class="px-3 py-2 text-on-surface hover:bg-surface-container-high font-bold">-</button>
                <input type="number" id="qty-input" name="quantity" value="1" min="1" max="10" 
                       class="w-12 text-center bg-transparent text-xs text-on-surface font-bold focus:outline-none" />
                <button type="button" onclick="incrementQty()" class="px-3 py-2 text-on-surface hover:bg-surface-container-high font-bold">+</button>
              </div>

              <button type="submit" 
                      class="flex-1 bg-primary-container text-on-primary py-3.5 px-6 font-label-caps text-xs uppercase font-bold hover:bg-inverse-primary transition-all flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(21,54,200,0.4)]">
                <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
                <span>Add To Bag</span>
              </button>
            </div>
          </form>

          <!-- Tactical Guarantees -->
          <div class="border-t border-outline-variant/20 pt-4 grid grid-cols-2 gap-4 text-xs font-label-tech text-on-surface-variant">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-primary text-[18px]">local_shipping</span>
              <span>FREE EXP DISPATCH</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-[18px]">verified_user</span>
              <span>AUTHENTIC CERTIFIED</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Related Sneakers Section -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
      <section class="w-full px-4 md:px-12 py-12 max-w-7xl mx-auto space-y-6 border-t border-outline-variant/30">
        <h3 class="font-headline-sm text-xl uppercase text-on-surface font-bold">Synchronized Recommendations</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <% relatedProducts.forEach(rel => { %>
            <div class="bg-surface-container-low border border-outline-variant/30 p-4 space-y-3">
              <div class="aspect-[4/3] bg-surface-container flex items-center justify-center p-4">
                <img src="<%= rel.image %>" alt="<%= rel.name %>" class="w-full h-full object-contain">
              </div>
              <h4 class="font-headline-sm text-sm uppercase text-on-surface font-bold"><%= rel.name %></h4>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-primary font-bold">$<%= Number(rel.price).toFixed(2) %></span>
                <a href="/products/<%= rel.id %>" class="text-xs uppercase text-primary font-bold hover:underline">View &rarr;</a>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

  </div>
</main>

<script>
  function selectSize(sz) {
    document.getElementById('selected-size-input').value = sz;
    document.getElementById('size-indicator').innerText = 'SIZE: ' + sz;
    document.querySelectorAll('.size-pill').forEach(btn => {
      btn.className = 'size-pill py-2.5 text-center text-xs font-label-caps border border-outline-variant/40 bg-surface-container text-on-surface hover:border-primary transition-all';
    });
    const activeBtn = document.getElementById('size-btn-' + sz);
    if (activeBtn) {
      activeBtn.className = 'size-pill py-2.5 text-center text-xs font-label-caps border border-primary bg-primary-container text-on-primary font-bold shadow-md transition-all';
    }
  }

  function incrementQty() {
    const input = document.getElementById('qty-input');
    input.value = Math.min(10, parseInt(input.value || 1, 10) + 1);
  }

  function decrementQty() {
    const input = document.getElementById('qty-input');
    input.value = Math.max(1, parseInt(input.value || 1, 10) - 1);
  }
</script>

<%- include('partials/footer') %>
