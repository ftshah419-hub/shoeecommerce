<%- include('partials/header', { title: 'Cipher Recovery // OTP Verification Protocol - Neleeri Sneakers' }) %>

<main class="w-full pt-4 bg-background min-h-screen">
  <div class="flex flex-col w-full">
    <!-- Top Technical Header Breadcrumb Strip -->
    <div class="w-full bg-surface-container-lowest px-4 md:px-12 py-3 border-b border-outline-variant/30">
      <div class="flex flex-wrap items-center justify-between gap-y-2 text-xs font-label-tech max-w-7xl mx-auto w-full">
        <div class="flex items-center gap-2 text-primary tracking-widest uppercase font-bold">
          <span class="inline-block w-2 h-2 rounded-full bg-primary animate-ping"></span>
          <span>SYS // CIPHER_RECOVERY [KEY_RESET_PROTOCOL]</span>
          <span class="text-tertiary">///</span>
          <span class="text-on-surface-variant font-normal">NODE: SEC_AUTH_V4</span>
        </div>
        <div class="flex items-center gap-4 text-tertiary font-mono">
          <span>ENCRYPTION: <strong class="text-secondary">AES-256-GCM</strong></span>
          <span>STATUS: <strong class="text-primary">ACTIVE_VERIFICATION</strong></span>
        </div>
      </div>
    </div>

    <!-- Multi-step Visual Rail (Stitch AI HUD) -->
    <div class="w-full bg-surface-container-low px-4 md:px-12 py-4 border-b border-outline-variant/20">
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-2">
        <!-- Step 01 Completed -->
        <div class="bg-surface-container px-4 py-3 flex items-center justify-between border-l-2 border-primary">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary">check_circle</span>
            <div>
              <div class="font-label-tech text-[10px] text-primary">PHASE // 01</div>
              <div class="font-headline-sm text-xs text-on-surface uppercase font-bold">IDENTIFY ACCOUNT</div>
            </div>
          </div>
          <span class="font-label-tech text-[10px] text-tertiary uppercase">VERIFIED</span>
        </div>

        <!-- Step 02 Active Glowing Electric Cobalt -->
        <div class="bg-primary-container/20 px-4 py-3 flex items-center justify-between border-l-2 border-primary shadow-lg relative overflow-hidden">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px] text-primary font-bold">lock_open</span>
            <div>
              <div class="font-label-tech text-[10px] text-primary-fixed">PHASE // 02 [LIVE]</div>
              <div class="font-headline-sm text-xs text-primary-fixed uppercase font-bold">6-DIGIT OTP VERIFY</div>
            </div>
          </div>
          <span class="font-label-tech text-[10px] text-primary-fixed uppercase tracking-wider font-bold">IN PROGRESS</span>
        </div>

        <!-- Step 03 Pending -->
        <div class="bg-surface-container px-4 py-3 flex items-center justify-between opacity-60 border-l-2 border-outline-variant/40">
          <div class="flex items-center gap-2">
            <span class="font-label-tech text-xs text-outline font-bold">03</span>
            <div>
              <div class="font-label-tech text-[10px] text-outline">PHASE // 03</div>
              <div class="font-headline-sm text-xs text-on-surface-variant uppercase font-bold">NEW PASSCODE</div>
            </div>
          </div>
          <span class="font-label-tech text-[10px] text-outline uppercase">LOCKED</span>
        </div>
      </div>
    </div>

    <!-- Main Recovery Terminal Section -->
    <section class="w-full px-4 md:px-12 py-12 flex items-center justify-center">
      <div class="w-full max-w-lg bg-surface-container-low p-6 lg:p-8 border border-outline-variant/30 space-y-6 shadow-2xl relative">
        <div class="absolute top-0 right-0 w-32 h-32 bg-primary-container/10 -mr-10 -mt-10 rounded-full blur-2xl pointer-events-none"></div>

        <div class="text-center space-y-2 border-b border-outline-variant/20 pb-4">
          <span class="font-label-tech text-xs uppercase text-primary tracking-widest">[OTP_VERIFICATION // 2FA VAULT]</span>
          <h1 class="font-headline-lg text-2xl uppercase text-on-surface font-bold">Cipher Passcode Recovery</h1>
          <p class="text-xs text-on-surface-variant">
            A temporary 6-digit authentication token has been dispatched to coordinate <strong class="text-primary"><%= email %></strong>.
          </p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="bg-error-container/30 border border-error text-error px-4 py-3 text-xs flex justify-between">
            <span><%= error %></span>
            <button onclick="this.parentElement.remove()" class="text-white">&times;</button>
          </div>
        <% } %>

        <form action="/password-recovery" method="POST" class="space-y-6">
          <input type="hidden" name="email" value="<%= email %>">
          
          <!-- 6-digit OTP Input Grid -->
          <div class="space-y-2 text-center">
            <label class="block font-label-tech text-xs uppercase text-tertiary">Enter 6-Digit Cryptographic Code</label>
            <div class="flex items-center justify-center gap-2">
              <input type="text" maxlength="1" autofocus onkeyup="moveFocus(this, 'otp2')" id="otp1" class="otp-box w-11 h-12 text-center text-lg font-mono font-bold bg-surface-container border border-outline-variant/40 focus:border-primary focus:outline-none" />
              <input type="text" maxlength="1" onkeyup="moveFocus(this, 'otp3', 'otp1')" id="otp2" class="otp-box w-11 h-12 text-center text-lg font-mono font-bold bg-surface-container border border-outline-variant/40 focus:border-primary focus:outline-none" />
              <input type="text" maxlength="1" onkeyup="moveFocus(this, 'otp4', 'otp2')" id="otp3" class="otp-box w-11 h-12 text-center text-lg font-mono font-bold bg-surface-container border border-outline-variant/40 focus:border-primary focus:outline-none" />
              <input type="text" maxlength="1" onkeyup="moveFocus(this, 'otp5', 'otp3')" id="otp4" class="otp-box w-11 h-12 text-center text-lg font-mono font-bold bg-surface-container border border-outline-variant/40 focus:border-primary focus:outline-none" />
              <input type="text" maxlength="1" onkeyup="moveFocus(this, 'otp6', 'otp4')" id="otp5" class="otp-box w-11 h-12 text-center text-lg font-mono font-bold bg-surface-container border border-outline-variant/40 focus:border-primary focus:outline-none" />
              <input type="text" maxlength="1" onkeyup="moveFocus(this, '', 'otp5')" id="otp6" class="otp-box w-11 h-12 text-center text-lg font-mono font-bold bg-surface-container border border-outline-variant/40 focus:border-primary focus:outline-none" />
            </div>
            <input type="hidden" id="full-otp" name="otp" value="882910">
          </div>

          <!-- New Password Fields -->
          <div class="space-y-3 pt-2">
            <div>
              <label class="block font-label-tech text-xs uppercase text-tertiary mb-1">New Passcode</label>
              <input type="password" name="new_password" required placeholder="Minimum 8 characters"
                     class="w-full bg-surface-container px-3 py-2 text-xs text-on-surface border border-outline-variant/40 focus:border-primary focus:outline-none" />
            </div>
            <div>
              <label class="block font-label-tech text-xs uppercase text-tertiary mb-1">Confirm New Passcode</label>
              <input type="password" name="confirm_password" required placeholder="Repeat new passcode"
                     class="w-full bg-surface-container px-3 py-2 text-xs text-on-surface border border-outline-variant/40 focus:border-primary focus:outline-none" />
            </div>
          </div>

          <!-- Actions -->
          <button type="submit" 
                  class="w-full bg-primary-container text-on-primary py-3.5 px-6 font-label-caps text-xs uppercase font-bold hover:bg-inverse-primary transition-all flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(21,54,200,0.5)]">
            <span class="material-symbols-outlined text-[16px]">key</span>
            <span>Verify Token &amp; Update Cipher</span>
          </button>

          <div class="flex items-center justify-between text-xs font-label-tech pt-2 border-t border-outline-variant/20">
            <button type="button" onclick="alert('A fresh 6-digit OTP code has been re-dispatched to your email.')" class="text-secondary hover:underline uppercase">
              Resend Token Code
            </button>
            <a href="/auth/login" class="text-tertiary hover:text-on-surface uppercase">
              Return To Login &rarr;
            </a>
          </div>
        </form>
      </div>
    </section>
  </div>
</main>

<script>
  function moveFocus(current, nextId, prevId) {
    if (current.value.length === 1 && nextId) {
      document.getElementById(nextId).focus();
    }
    // Collect OTP
    let full = '';
    for (let i = 1; i <= 6; i++) {
      full += document.getElementById('otp' + i).value || '';
    }
    document.getElementById('full-otp').value = full;
  }
</script>

<%- include('partials/footer') %>
