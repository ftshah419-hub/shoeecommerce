<%- include('../partials/user-header') %>
<%- include('../partials/navbar') %>

<main class="container section">
  <h1 class="section-title" style="margin-bottom: 2rem;">Your Shopping Bag</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success"><%= success %></div>
  <% } %>

  <% if (cart && cart.length > 0) { %>
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2.5rem; align-items: start;">
      <!-- Cart Items List -->
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% cart.forEach(item => { %>
          <div class="bag-item-card cart-item-row">
            <img src="<%= item.image %>" alt="<%= item.name %>" class="bag-item-img">
            <div style="flex-grow: 1;">
              <h3 style="font-size: 1.05rem;"><%= item.name %></h3>
              <p style="color: var(--text-muted); font-size: 0.85rem;">Size: US <%= item.size %> | Qty: <%= item.quantity %></p>
              <p style="color: var(--accent); font-weight: 700; margin-top: 0.25rem;">$<%= (item.price * item.quantity).toFixed(2) %></p>
            </div>
            <form action="/cart/remove" method="POST">
              <input type="hidden" name="productId" value="<%= item.productId %>">
              <input type="hidden" name="size" value="<%= item.size %>">
              <button type="submit" class="btn btn-secondary btn-sm" style="color: var(--danger);">Remove</button>
            </form>
          </div>
        <% }) %>
      </div>

      <!-- Checkout Summary Box -->
      <div style="background: var(--bg-card); padding: 1.75rem; border-radius: var(--radius); border: 1px solid var(--border);">
        <h3 style="margin-bottom: 1.25rem; font-size: 1.2rem;">Order Summary</h3>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; color: var(--text-muted);">
          <span>Subtotal</span>
          <span>$<%= subtotal.toFixed(2) %></span>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; color: var(--text-muted);">
          <span>Estimated Shipping</span>
          <span><%= shipping === 0 ? 'FREE' : '$' + shipping.toFixed(2) %></span>
        </div>
        <hr style="border: none; border-top: 1px solid var(--border); margin: 1rem 0;">
        <div style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 800; margin-bottom: 1.5rem;">
          <span>Total</span>
          <span style="color: var(--accent);">$<%= total.toFixed(2) %></span>
        </div>

        <% if (locals.currentUser) { %>
          <form action="/checkout" method="POST">
            <h4 style="font-size: 0.95rem; margin-bottom: 0.75rem;">Shipping Details</h4>
            <div class="form-group">
              <label class="form-label">Street Address</label>
              <input type="text" name="street" class="form-control" placeholder="123 Sneakerhead Blvd" required>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <div class="form-group">
                <label class="form-label">City</label>
                <input type="text" name="city" class="form-control" placeholder="New York" required>
              </div>
              <div class="form-group">
                <label class="form-label">Postal / Zip</label>
                <input type="text" name="zipCode" class="form-control" placeholder="10001" required>
              </div>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">
              Complete Purchase
            </button>
          </form>
        <% } else { %>
          <div style="text-align: center; padding: 1rem 0;">
            <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1rem;">
              Please sign in to complete your checkout.
            </p>
            <a href="/auth/login?redirect=/cart" class="btn btn-primary" style="width: 100%;">
              Log In to Checkout
            </a>
          </div>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 4rem 1rem; background: var(--bg-card); border-radius: var(--radius); border: 1px solid var(--border);">
      <h3 style="font-size: 1.4rem; margin-bottom: 0.5rem;">Your bag is currently empty</h3>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Check out the latest sneakers in our catalog.</p>
      <a href="/products" class="btn btn-primary">Start Shopping</a>
    </div>
  <% } %>
</main>

<%- include('../partials/user-footer') %>
