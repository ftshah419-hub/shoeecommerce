<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <div class="auth-box">
    <div class="auth-header">
      <h2>Forgot Password?</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
        Enter your registered email or mobile number to receive a 6-digit recovery code.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/auth/forgot-password" method="POST" data-auth-form>
      <div class="form-group">
        <label class="form-label" for="identifier">Email Address or Mobile Number</label>
        <input 
          class="form-control" 
          type="text" 
          id="identifier" 
          name="identifier" 
          value="<%= typeof identifier !== 'undefined' ? identifier : '' %>"
          placeholder="e.g. user@example.com or +15551234567" 
          required 
          autofocus
        />
        <small style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-top: 0.35rem;">
          We will send a one-time verification code (valid for 10 minutes).
        </small>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Send Recovery Code
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted);">
      Remember your password? <a href="/auth/login" style="color: var(--accent); font-weight: 600;">Back to Sign In</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
