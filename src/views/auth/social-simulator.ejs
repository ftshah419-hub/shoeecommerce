<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <div class="auth-box">
    <div class="auth-header">
      <h2><%= provider %> Authentication</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
        OAuth Identity Provider Gateway
      </p>
    </div>

    <div style="background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 1.25rem; font-size: 0.85rem; margin-bottom: 1.5rem;">
      <p style="font-weight: 700; color: var(--accent); margin-bottom: 0.5rem;">
        🔐 Buildathon Integration Notice:
      </p>
      <p style="color: var(--text-muted); line-height: 1.5;">
        Live OAuth requires registering client credentials in your Google Cloud or Apple Developer console and configuring:
      </p>
      <code style="display: block; background: #000; padding: 0.5rem; border-radius: 4px; margin: 0.5rem 0; font-size: 0.75rem; color: #60a5fa;">
        GOOGLE_CLIENT_ID=your_client_id<br>
        GOOGLE_CLIENT_SECRET=your_client_secret
      </code>
      <p style="color: var(--text-muted); margin-top: 0.5rem;">
        The underlying <code>social_accounts</code> database table, backend service, and account linking are fully implemented. You can test social account sign-in below:
      </p>
    </div>

    <form action="/auth/social/<%= providerKey %>" method="POST">
      <input type="hidden" name="providerUserId" value="<%= providerKey %>_user_demo_101">
      <input type="hidden" name="profile[email]" value="demo.<%= providerKey %>@neleerisneakers.com">
      <input type="hidden" name="profile[firstName]" value="Sneaker">
      <input type="hidden" name="profile[lastName]" value="<%= provider %>VIP">
      <input type="hidden" name="profile[name]" value="Sneaker <%= provider %>VIP">

      <button type="submit" class="btn btn-primary" style="width: 100%;">
        Authenticate with Simulated <%= provider %> Account
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem;">
      <a href="/auth/login" style="color: var(--text-muted);">&larr; Return to Sign In</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
