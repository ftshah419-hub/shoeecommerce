<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <div class="auth-box">
    <div class="auth-header">
      <h2>Welcome Back</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
        Log in to your Neleeri Sneakers account
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/auth/login" method="POST" data-auth-form>
      <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">
      
      <div class="form-group">
        <label class="form-label" for="identifier">Email Address or Mobile Number</label>
        <input 
          class="form-control" 
          type="text" 
          id="identifier" 
          name="identifier" 
          value="<%= typeof identifier !== 'undefined' ? identifier : '' %>"
          placeholder="e.g. john@example.com or +15550000002" 
          autocomplete="username"
          required 
        />
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
          <label class="form-label" for="password" style="margin-bottom: 0;">Password</label>
          <a href="/auth/forgot-password" style="font-size: 0.8rem; color: var(--accent); font-weight: 600;">
            Forgot Password?
          </a>
        </div>
        <div class="input-group">
          <input 
            class="form-control" 
            type="password" 
            id="password" 
            name="password" 
            placeholder="••••••••" 
            autocomplete="current-password"
            required 
          />
          <button 
            type="button" 
            class="password-toggle-btn" 
            data-target="password" 
            aria-label="Toggle password visibility"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
      </div>

      <label class="checkbox-wrap">
        <input type="checkbox" name="rememberMe" id="rememberMe">
        <span>Remember this device for 30 days</span>
      </label>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Sign In
      </button>
    </form>

    <div class="auth-divider">or continue with</div>

    <div class="social-auth-grid">
      <a href="/auth/social/google" class="btn-social">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z"/>
          <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9c-.3-.7-.5-1.5-.5-2.4z"/>
          <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2-6.4-4.8L1.9 17c1.8 3.7 5.6 6.5 10.1 6.5z"/>
        </svg>
        Google
      </a>
      <a href="/auth/social/apple" class="btn-social">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.38c.62-.75 1.04-1.8 1.01-2.88-1 .04-2.16.67-2.83 1.45-.58.67-1.1 1.74-.96 2.79 1.11.09 2.16-.61 2.78-1.36z"/>
        </svg>
        Apple
      </a>
    </div>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted);">
      Don't have an account? <a href="/auth/register" style="color: var(--accent); font-weight: 600;">Create one</a>
    </div>

    <div style="margin-top: 2rem; padding: 1rem; background: var(--bg-secondary); border-radius: 8px; font-size: 0.8rem; border: 1px dashed var(--border);">
      <p style="font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">Quick Demo Credentials:</p>
      <p>🛡️ <strong>Admin:</strong> admin@neleerisneakers.com / AdminSecurePassword123!</p>
      <p>👤 <strong>User:</strong> john@example.com (or +15550000002) / UserSecure123!</p>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
