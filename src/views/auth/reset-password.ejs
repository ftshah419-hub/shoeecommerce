<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <div class="auth-box">
    <div class="auth-header">
      <h2>Set New Password</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
        Choose a secure new password for your Neleeri account
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/auth/reset-password" method="POST" data-auth-form>
      <input type="hidden" name="resetToken" value="<%= resetToken %>">
      <input type="hidden" name="identifier" value="<%= typeof identifier !== 'undefined' ? identifier : '' %>">

      <!-- New Password -->
      <div class="form-group">
        <label class="form-label" for="password">New Password *</label>
        <div class="input-group">
          <input 
            class="form-control" 
            type="password" 
            id="password" 
            name="password" 
            placeholder="Min 8 characters with number & symbol" 
            minlength="8" 
            required 
            autofocus
          />
          <button 
            type="button" 
            class="password-toggle-btn" 
            data-target="password" 
            aria-label="Toggle password visibility"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>

        <!-- Strength Meter -->
        <div class="password-meter-wrap">
          <div class="password-meter-track">
            <div class="password-meter-fill" id="passwordMeterFill"></div>
          </div>
          <ul class="password-req-list">
            <li class="password-req-item" id="reqMinLength">&bull; 8+ characters</li>
            <li class="password-req-item" id="reqNumber">&bull; 1+ number</li>
            <li class="password-req-item" id="reqSpecial">&bull; 1+ special symbol</li>
          </ul>
        </div>
      </div>

      <!-- Confirm New Password -->
      <div class="form-group">
        <label class="form-label" for="confirmPassword">Confirm New Password *</label>
        <div class="input-group">
          <input 
            class="form-control" 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            placeholder="Re-enter your new password" 
            required 
          />
          <button 
            type="button" 
            class="password-toggle-btn" 
            data-target="confirmPassword" 
            aria-label="Toggle confirm password visibility"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
        <small id="passwordMatchNotice" style="display: none; font-size: 0.75rem; margin-top: 0.25rem; font-weight: 600;"></small>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Update Password
      </button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
