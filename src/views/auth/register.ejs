<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <div class="auth-box auth-box-lg">
    <div class="auth-header">
      <h2>Join Neleeri Sneakers</h2>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">
        Get exclusive drops, early access, and fast checkout
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="/auth/register" method="POST" data-auth-form>
      <!-- First & Last Name -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="firstName">First Name *</label>
          <input 
            class="form-control" 
            type="text" 
            id="firstName" 
            name="firstName" 
            value="<%= typeof formData !== 'undefined' && formData.firstName ? formData.firstName : '' %>"
            placeholder="e.g. Marcus" 
            required 
          />
        </div>
        <div class="form-group">
          <label class="form-label" for="lastName">Last Name *</label>
          <input 
            class="form-control" 
            type="text" 
            id="lastName" 
            name="lastName" 
            value="<%= typeof formData !== 'undefined' && formData.lastName ? formData.lastName : '' %>"
            placeholder="e.g. Jordan" 
            required 
          />
        </div>
      </div>

      <!-- Email Address -->
      <div class="form-group">
        <label class="form-label" for="email">Email Address *</label>
        <input 
          class="form-control" 
          type="email" 
          id="email" 
          name="email" 
          value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
          placeholder="marcus@example.com" 
          autocomplete="email"
          required 
        />
      </div>

      <!-- Mobile Number with Country Code -->
      <div class="form-group">
        <label class="form-label" for="phone">Mobile Number with Country Code *</label>
        <input 
          class="form-control" 
          type="tel" 
          id="phone" 
          name="phone" 
          value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
          placeholder="+1 555 123 4567" 
          autocomplete="tel"
          required 
        />
        <small style="color: var(--text-muted); font-size: 0.75rem; display: block; margin-top: 0.25rem;">
          Include country code prefix (e.g. +1 for US, +44 for UK, +91 for India).
        </small>
      </div>

      <!-- Preferred Shoe Size -->
      <div class="form-group">
        <label class="form-label" for="shoeSize">Preferred Shoe Size (US Men's) &mdash; Optional</label>
        <select class="form-control" id="shoeSize" name="shoeSize">
          <option value="">Select your sneaker size...</option>
          <% [6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5, 13, 14].forEach(size => { %>
            <option value="<%= size %>" <%= typeof formData !== 'undefined' && formData.shoeSize == size ? 'selected' : '' %>>
              US <%= size %>
            </option>
          <% }) %>
        </select>
      </div>

      <!-- Password with Strength Meter -->
      <div class="form-group">
        <label class="form-label" for="password">Password *</label>
        <div class="input-group">
          <input 
            class="form-control" 
            type="password" 
            id="password" 
            name="password" 
            placeholder="Min 8 characters with number & symbol" 
            autocomplete="new-password"
            minlength="8"
            required 
          />
          <button 
            type="button" 
            class="password-toggle-btn" 
            data-target="password" 
            aria-label="Toggle password visibility"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>

        <!-- Live Password Strength Meter -->
        <div class="password-meter-wrap">
          <div class="password-meter-track">
            <div class="password-meter-fill" id="passwordMeterFill"></div>
          </div>
          <ul class="password-req-list">
            <li class="password-req-item" id="reqMinLength">&bull; 8+ characters</li>
            <li class="password-req-item" id="reqNumber">&bull; At least 1 number</li>
            <li class="password-req-item" id="reqSpecial">&bull; 1 special symbol</li>
          </ul>
        </div>
      </div>

      <!-- Confirm Password -->
      <div class="form-group">
        <label class="form-label" for="confirmPassword">Confirm Password *</label>
        <div class="input-group">
          <input 
            class="form-control" 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            placeholder="Re-enter your password" 
            autocomplete="new-password"
            required 
          />
          <button 
            type="button" 
            class="password-toggle-btn" 
            data-target="confirmPassword" 
            aria-label="Toggle confirm password visibility"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </button>
        </div>
        <small id="passwordMatchNotice" style="display: none; font-size: 0.75rem; margin-top: 0.25rem; font-weight: 600;"></small>
      </div>

      <!-- Preferences & Checkboxes -->
      <div style="margin: 1.5rem 0 1rem;">
        <label class="checkbox-wrap">
          <input type="checkbox" name="marketingOptIn" id="marketingOptIn" <%= typeof formData !== 'undefined' && formData.marketingOptIn ? 'checked' : '' %>>
          <span>Receive exclusive drop alerts, sneaker restock alerts, and VIP member promos</span>
        </label>

        <label class="checkbox-wrap">
          <input type="checkbox" name="termsAgreed" id="termsAgreed" required checked>
          <span>I agree to the <a href="#" style="color: var(--accent); text-decoration: underline;">Terms & Conditions</a> and Privacy Policy *</span>
        </label>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Create Account
      </button>
    </form>

    <div class="auth-divider">or sign up with</div>

    <div class="social-auth-grid">
      <a href="/auth/social/google" class="btn-social">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/>
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z"/>
          <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9c-.3-.7-.5-1.5-.5-2.4z"/>
          <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2-6.4-4.8L1.9 17c1.8 3.7 5.6 6.5 10.1 6.5z"/>
        </svg>
        Google
      </a>
      <a href="/auth/social/apple" class="btn-social">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.38c.62-.75 1.04-1.8 1.01-2.88-1 .04-2.16.67-2.83 1.45-.58.67-1.1 1.74-.96 2.79 1.11.09 2.16-.61 2.78-1.36z"/>
        </svg>
        Apple
      </a>
    </div>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: var(--text-muted);">
      Already have an account? <a href="/auth/login" style="color: var(--accent); font-weight: 600;">Sign in here</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
